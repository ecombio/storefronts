  {
    "name": "t:general.header",
    "settings": [
      {
        "type": "header",
        "content": "t:general.header_settings"
      },
      {
        "type": "checkbox",
        "id": "enable_sticky_header",
        "label": "Sticky",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_header_autohide",
        "label": "Autohide",
        "info": "Hide the header when scrolling down, reveal it when scrolling back up.",
        "default": false,
        "visible_if": "{{ settings.enable_sticky_header }}"
      }
    ]
  },


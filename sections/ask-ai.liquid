<style>
  .footer-ai {
    max-width: 420px;
  }
  .footer-ai p {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    margin: 0 0 12px;
    color: {{ section.settings.text_color | default: '#ffffff' }};
  }
  .footer-ai ul {
    list-style: none;
    display: flex;
    gap: 14px;
    padding: 0;
    margin: 0;
  }
  .footer-ai a {
    display: inline-flex;
    width: 34px;
    height: 34px;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.08);
    color: {{ section.settings.text_color | default: '#ffffff' }};
    transition: transform .15s ease, background .15s ease;
  }
  .footer-ai a:hover {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.16);
  }
  .footer-ai svg { width: 18px; height: 18px; }
</style>

<script>
  (function () {
    document.querySelectorAll('.ask-ai-link').forEach(function (link) {
      link.addEventListener('click', function () {
        var platform = link.getAttribute('data-platform');
        var brand = link.closest('.footer-ai').getAttribute('data-ask-ai-brand');
        // Wire into whatever analytics the theme already loads.
        if (typeof gtag === 'function') {
          gtag('event', 'ask_ai_click', { ai_platform: platform, brand: brand });
        }
        if (window.analytics && typeof window.analytics.track === 'function') {
          window.analytics.track('Ask AI Click', { platform: platform, brand: brand });
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Ask AI",
  "tag": "section",
  "class": "section-ask-ai",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label prefix",
      "default": "Ask AI"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "info": "Defaults to your store name if left blank."
    },
    {
      "type": "url",
      "id": "brand_url",
      "label": "Brand URL",
      "info": "Defaults to your store's primary domain if left blank."
    },
    {
      "type": "text",
      "id": "category",
      "label": "Product category",
      "info": "e.g. \"ecommerce email & SMS marketing tools\". Leave blank to omit the comparison clause entirely.",
      "default": "ecommerce email & SMS marketing tools"
    },
    {
      "type": "text",
      "id": "competitor_1",
      "label": "Competitor 1 (optional)"
    },
    {
      "type": "text",
      "id": "competitor_2",
      "label": "Competitor 2 (optional)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text / icon color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Platforms to show"
    },
    { "type": "checkbox", "id": "show_chatgpt", "label": "ChatGPT", "default": true },
    { "type": "checkbox", "id": "show_perplexity", "label": "Perplexity", "default": true },
    { "type": "checkbox", "id": "show_google", "label": "Google AI Mode", "default": true },
    { "type": "checkbox", "id": "show_claude", "label": "Claude", "default": true },
    { "type": "checkbox", "id": "show_grok", "label": "Grok", "default": true }
  ],
  "presets": [
    {
      "name": "Ask AI"
    }
  ]
}
{% endschema %}

{%- comment -%}
  Usage:
  1. Save as sections/ask-ai.liquid in your theme.
  2. Drop {% section 'ask-ai' %} into your footer template/group
     (e.g. sections/footer.liquid, or as a block if your footer uses
     section-groups / theme blocks in a Online Store 2.0 theme).
  3. Configure brand name, category, and competitors in the theme editor —
     no code changes needed per store.
{%- endcomment -%}

{%- comment -%}
  sections/ask-ai.liquid
  Renders an "Ask AI about [Brand]" footer widget with deep links into
  ChatGPT, Perplexity, Google AI Mode, Claude, and Grok — each prefilled
  with a merchant-configurable analyst-style prompt.

  Add to theme footer via: {% section 'ask-ai' %}
  Or make it app-block/section-group compatible — see note at bottom.
{%- endcomment -%}

{%- liquid
  assign brand_name = section.settings.brand_name | default: shop.name
  assign brand_url = section.settings.brand_url | default: shop.url
  assign category = section.settings.category
  assign competitor_1 = section.settings.competitor_1
  assign competitor_2 = section.settings.competitor_2

  assign competitors = ''
  if competitor_1 != blank and competitor_2 != blank
    assign competitors = competitor_1 | append: ' or ' | append: competitor_2
  elsif competitor_1 != blank
    assign competitors = competitor_1
  endif

  assign prompt = 'Act as an independent analyst. Using publicly available information, briefly explain what '
  assign prompt = prompt | append: brand_name | append: ' (' | append: brand_url | append: ') does, who it is best for'
  if category != blank
    assign prompt = prompt | append: ', and the top 3 features that differentiate it from ' | append: category
    if competitors != blank
      assign prompt = prompt | append: ' like ' | append: competitors
    endif
  endif
  assign prompt = prompt | append: '. Keep the response factual, clearly categorized, and concise.'
-%}

<div class="footer-ai" data-ask-ai-brand="{{ brand_name | escape }}">
  <p>
    {{ section.settings.label | default: 'Ask AI' }}
    <svg width="17" height="17" viewBox="0 0 17 17" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">

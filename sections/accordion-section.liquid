{{ 'accordion.css' | asset_url | stylesheet_tag }}

<div class="accordion">
  {% for block in section.blocks %}
    <details class="accordion__item" {% if forloop.first %}open{% endif %}>
      <summary class="accordion__summary">
        <span>{{ block.settings.heading }}</span>
        <svg class="accordion__icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <div class="accordion__content">
        {{ block.settings.content }}
      </div>
    </details>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Accordion",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Accordion item",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Account Settings"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Accordion",
      "blocks": [
        { "type": "item", "settings": { "heading": "Account Settings" } },
        { "type": "item", "settings": { "heading": "Privacy & Permissions" } },
        { "type": "item", "settings": { "heading": "Notifications & Alerts" } }
      ]
    }
  ]
}
{% endschema %}

{{ 'main-athletes.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign width_type = section.settings.section_width
  if width_type == blank
    assign width_class = 'athletes-section__default-width'
  else
    assign width_class = 'athletes-section__' | append: width_type
  endif
-%}

<div
  class="athletes-section {{ width_class }}"
  data-section-type="main-athletes"
  id="athletes-section-{{ section.id }}"
  style="
    --section-padding: {{ section.settings.section_padding }}px;
    {%- if width_type == 'custom-width' %}
      --custom-width: {{ section.settings.custom_width }}rem;
    {%- endif %}
  "
>
  {%- if article -%}
    {%- assign athlete_name = article.metafields.custom.athlete_match_name | default: article.title -%}
    {%- assign current_blog_handle = article.blog.handle -%}

    <header class="athletes-section__header">
      {%- if section.settings.show_photo -%}
        <div class="athletes-section__photo-wrapper">
          {%- if article.image -%}
            <img
              src="{{ article.image | image_url: width: 500 }}"
              srcset="{{ article.image | image_url: width: 300 }} 300w, {{ article.image | image_url: width: 500 }} 500w, {{ article.image | image_url: width: 700 }} 700w"
              sizes="(max-width: 640px) 160px, 200px"
              alt="{{ article.image.alt | default: athlete_name | escape }}"
              class="athletes-section__photo"
              width="{{ article.image.width }}"
              height="{{ article.image.height }}"
              loading="eager"
            >
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'athletes-section__photo athletes-section__photo--placeholder' }}
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="athletes-section__intro">
        <h1 class="athletes-section__name">
          {{ section.settings.heading | default: athlete_name }}
        </h1>

        {%- if article.metafields.custom.athlete_sport != blank or article.metafields.custom.athlete_team != blank or article.metafields.custom.athlete_position != blank -%}
          <ul class="athletes-section__stats">
            {%- if article.metafields.custom.athlete_sport != blank -%}
              <li class="athletes-section__stat">
                <span class="athletes-section__stat-label">Sport</span>
                <span class="athletes-section__stat-value">{{ article.metafields.custom.athlete_sport }}</span>
              </li>
            {%- endif -%}
            {%- if article.metafields.custom.athlete_team != blank -%}
              <li class="athletes-section__stat">
                <span class="athletes-section__stat-label">Team</span>
                <span class="athletes-section__stat-value">{{ article.metafields.custom.athlete_team }}</span>
              </li>
            {%- endif -%}
            {%- if article.metafields.custom.athlete_position != blank -%}
              <li class="athletes-section__stat">
                <span class="athletes-section__stat-label">Position</span>
                <span class="athletes-section__stat-value">{{ article.metafields.custom.athlete_position }}</span>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.show_bio and article.content != blank -%}
          <div class="athletes-section__bio">{{ article.content }}</div>
        {%- endif -%}
      </div>
    </header>

    {%- assign matched = blank -%}
    {%- assign has_seed = false -%}

    {%- if section.settings.search_all_blogs -%}
      {%- for blog in blogs -%}
        {%- unless blog.handle == current_blog_handle -%}
          {%- assign blog_matches = blog.articles | where: "author", athlete_name -%}
          {%- if blog_matches.size > 0 -%}
            {%- if has_seed -%}
              {%- assign matched = matched | concat: blog_matches -%}
            {%- else -%}
              {%- assign matched = blog_matches -%}
              {%- assign has_seed = true -%}
            {%- endif -%}
          {%- endif -%}
        {%- endunless -%}
      {%- endfor -%}
    {%- elsif section.settings.specific_blog != blank -%}
      {%- assign matched = section.settings.specific_blog.articles | where: "author", athlete_name -%}
    {%- endif -%}

    {%- assign matched = matched | sort: "published_at" | reverse -%}
    {%- assign matched = matched | slice: 0, 60 -%}

    {%- render 'athletes-grid',
      articles: matched,
      heading: section.settings.articles_heading,
      per_page: section.settings.per_page,
      load_more_increment: section.settings.load_more_increment,
      empty_state_text: section.settings.empty_state_text,
      avatar: article.image,
      avatar_alt: athlete_name
    -%}
  {%- elsif blog -%}
    {%- liquid
      assign roster = blog.articles

      if section.settings.roster_sort_by == 'title'
        assign roster = roster | sort: 'title'
      else
        assign roster = roster | sort: 'published_at' | reverse
      endif

      assign roster = roster | slice: 0, 120
    -%}

    {%- render 'athletes-grid',
      articles: roster,
      heading: section.settings.roster_heading,
      per_page: section.settings.roster_per_page,
      load_more_increment: section.settings.roster_load_more_increment,
      empty_state_text: section.settings.roster_empty_state_text,
      use_own_photo: true,
      demo_count: section.settings.roster_demo_count
    -%}
  {%- else -%}
    <div class="athletes-section__empty athletes-section__empty--config">
      This section only works on an athlete's article page or on the
      athletes blog's own listing page.
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Main athletes",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override",
      "info": "Leave blank to use the athlete's title automatically."
    },
    {
      "type": "checkbox",
      "id": "show_photo",
      "label": "Show photo",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_bio",
      "label": "Show bio",
      "default": true
    },
    {
      "type": "text",
      "id": "articles_heading",
      "label": "Articles heading",
      "default": "Latest articles"
    },
    {
      "type": "checkbox",
      "id": "search_all_blogs",
      "label": "Search all blogs for this athlete's posts",
      "default": true
    },
    {
      "type": "blog",
      "id": "specific_blog",
      "label": "Or limit to a specific blog",
      "info": "Only used when \"Search all blogs\" is off."
    },
    {
      "type": "range",
      "id": "per_page",
      "min": 3,
      "max": 24,
      "step": 3,
      "label": "Articles shown initially",
      "default": 9
    },
    {
      "type": "range",
      "id": "load_more_increment",
      "min": 3,
      "max": 12,
      "step": 3,
      "label": "Articles revealed per \"Load more\" click",
      "default": 6
    },
    {
      "type": "text",
      "id": "empty_state_text",
      "label": "Empty state message",
      "default": "No articles published yet."
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Roster settings (blog listing page only)"
    },
    {
      "type": "text",
      "id": "roster_heading",
      "label": "Roster heading",
      "default": "Our athletes"
    },
    {
      "type": "select",
      "id": "roster_sort_by",
      "label": "Sort by",
      "options": [
        { "value": "recent", "label": "Recently published" },
        { "value": "title", "label": "Name (A-Z)" }
      ],
      "default": "title"
    },
    {
      "type": "range",
      "id": "roster_per_page",
      "min": 4,
      "max": 48,
      "step": 4,
      "label": "Athletes shown initially",
      "default": 12
    },
    {
      "type": "range",
      "id": "roster_load_more_increment",
      "min": 4,
      "max": 24,
      "step": 4,
      "label": "Athletes revealed per \"Load more\" click",
      "default": 8
    },
    {
      "type": "text",
      "id": "roster_empty_state_text",
      "label": "Roster empty state message",
      "default": "No athletes published yet."
    },
    {
      "type": "range",
      "id": "roster_demo_count",
      "min": 0,
      "max": 8,
      "step": 1,
      "label": "Placeholder cards to show when the blog is empty",
      "info": "Set to 0 to hide placeholders and show the empty state message instead.",
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "Main athletes"
    }
  ]
}
{% endschema %}

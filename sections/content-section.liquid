<link rel="stylesheet" href="{{ 'content-section.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'content-section.css' | asset_url | stylesheet_tag }}</noscript>

{%- liquid
  assign v = section.settings.video
  assign has_video = false
  if section.settings.media_type == 'video' and v != blank
    assign has_video = true
  endif

  # Reserve real space for the media column up front (via CSS aspect-ratio)
  # instead of letting it collapse to zero height until the image/video
  # loads. Prevents layout shift, and — for video facades specifically —
  # prevents the embed from collapsing to 0px after the facade button
  # (which used to be the only element carrying an aspect-ratio) is
  # replaced by the iframe on click.
  if has_video
    assign media_ratio = v.aspect_ratio | default: 1.78
  elsif section.settings.image
    assign media_ratio = section.settings.image.aspect_ratio | default: 1.33
  else
    assign media_ratio = 1.33
  endif
-%}

{%- style -%}
  .section-{{ section.id }} {
    --content-media-width: {{ section.settings.media_width }}%;
    --content-media-ratio: {{ media_ratio }};
    --content-gap: {{ section.settings.column_gap }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- if section.settings.background_color != blank -%}
      --content-bg: {{ section.settings.background_color }};
    {%- endif -%}
    {%- if section.settings.text_color != blank -%}
      --content-text: {{ section.settings.text_color }};
    {%- endif -%}
  }
  @media screen and (max-width: 749px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign content_inner_class = 'content-section__inner content-section__inner--align-' | append: section.settings.vertical_alignment
  assign content_section_class = 'content-section section-' | append: section.id | append: ' color-' | append: section.settings.color_scheme
  if section.settings.reverse_layout
    assign content_section_class = content_section_class | append: ' content-section--reverse'
  endif
  unless section.settings.mobile_media_first
    assign content_section_class = content_section_class | append: ' content-section--mobile-content-first'
  endunless
-%}
<div
  {% render 'section-width', section: section, extra_class: content_section_class %}
  data-section-id="{{ section.id }}"
  data-section-type="content"
>
  <div class="{{ content_inner_class }}">
    <div class="content-section__media">
      {%- if has_video -%}
        <div class="content-section__media-wrap content-section__media-wrap--video" data-video-wrap>
          {%- if v.host == 'shopify' -%}
            {%- liquid
              assign mp4_sources = v.sources | where: 'format', 'mp4' | sort: 'width'

              # Default to the largest available source (always valid,
              # matches previous behavior) then try to find a source
              # that's "big enough" for each breakpoint instead of
              # always shipping the largest file regardless of how
              # small the media column actually renders.
              assign desktop_source = mp4_sources | last
              assign mobile_source = mp4_sources | last

              for source in mp4_sources
                if source.width >= 1280
                  assign desktop_source = source
                  break
                endif
              endfor

              for source in mp4_sources
                if source.width >= 640
                  assign mobile_source = source
                  break
                endif
              endfor
            -%}
            <video
              class="content-section__video"
              data-video-mobile-src="{{ mobile_source.url }}"
              data-video-desktop-src="{{ desktop_source.url }}"
              {%- if v.preview_image %} poster="{{ v.preview_image | image_url: width: 1100 }}"{% endif %}
              playsinline
              {% if section.settings.loop %}loop{% endif %}
              {% if section.settings.autoplay %}data-video-autoplay="true" muted{% endif %}
              {% if section.settings.show_controls %}controls{% endif %}
              preload="none"
            ></video>
          {%- else -%}
            <button
              type="button"
              class="content-section__video-facade"
              data-video-facade
              data-video-host="{{ v.host }}"
              data-video-id="{{ v.id }}"
              data-video-autoplay="{{ section.settings.autoplay }}"
              aria-label="Play video"
            >
              {%- if v.preview_image -%}
                {{
                  v.preview_image
                  | image_url: width: 1100
                  | image_tag:
                    loading: 'lazy',
                    widths: '375, 550, 750, 1100',
                    sizes: '(min-width: 750px) 50vw, 100vw',
                    class: 'content-section__video-poster',
                    alt: section.settings.heading
                }}
              {%- endif -%}
              <span class="content-section__play-icon" aria-hidden="true"></span>
            </button>
          {%- endif -%}
        </div>
      {%- elsif section.settings.image -%}
        <div class="content-section__media-wrap">
          {{
            section.settings.image
            | image_url: width: 1500
            | image_tag:
              loading: 'lazy',
              widths: '375, 550, 750, 1100, 1500',
              sizes: '(min-width: 750px) 50vw, 100vw',
              class: 'content-section__image',
              alt: section.settings.image.alt | default: section.settings.heading
          }}
        </div>
      {%- else -%}
        <div class="content-section__media-wrap content-section__media-wrap--placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'content-section__placeholder' }}
        </div>
      {%- endif -%}
    </div>

    <div class="content-section__content">
      <div class="content-section__content-inner">
        {%- if section.settings.subheading != blank -%}
          <p class="content-section__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="content-section__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="content-section__text rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
          <div class="content-section__buttons">
            {%- if section.settings.button_1_label != blank -%}
              <a
                {% if section.settings.button_1_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ section.settings.button_1_link }}"{% endif %}
                class="button button--{{ section.settings.button_1_style }}"
              >
                {{ section.settings.button_1_label | escape }}
              </a>
            {%- endif -%}
            {%- if section.settings.button_2_label != blank -%}
              <a
                {% if section.settings.button_2_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ section.settings.button_2_link }}"{% endif %}
                class="button button--{{ section.settings.button_2_style }}"
              >
                {{ section.settings.button_2_label | escape }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>

  </div>
</div>

<script src="{{ 'content-section.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Content",
  "tag": "section",
  "class": "shopify-section--content",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "reverse_layout",
      "label": "Swap column order (media on right)",
      "default": false
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "options": [
        { "value": "start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "Media column width",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "checkbox",
      "id": "mobile_media_first",
      "label": "Show media first on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Upload a file, or paste a YouTube/Vimeo URL."
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay (muted, loops silently)",
      "default": false,
      "info": "Only applies to uploaded video files."
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop video",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Show video controls",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for every ride"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Tell your story here. Describe the product, the mission, or what makes this moment worth stopping for.</p>"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "First button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "First button link"
    },
    {
      "type": "select",
      "id": "button_1_style",
      "label": "First button style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "primary"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Second button label"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Second button link"
    },
    {
      "type": "select",
      "id": "button_2_style",
      "label": "Second button style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "secondary"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Leave blank to inherit the color scheme's background."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "Leave blank to inherit the color scheme's text color."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Content"
    },
    {
      "name": "Content — Image right",
      "settings": {
        "reverse_layout": true
      }
    },
    {
      "name": "Content — Video feature",
      "settings": {
        "media_type": "video",
        "autoplay": true,
        "loop": true,
        "show_controls": false
      }
    },
    {
      "name": "Content — Full bleed",
      "settings": {
        "section_width": "full-width",
        "section_padding": 0,
        "media_width": 60,
        "column_gap": 0
      }
    },
    {
      "name": "Content — Compact",
      "settings": {
        "section_width": "custom-width",
        "custom_width": 60,
        "media_width": 45,
        "column_gap": 40,
        "padding_top": 48,
        "padding_bottom": 48,
        "padding_top_mobile": 32,
        "padding_bottom_mobile": 32
      }
    }
  ]
}
{% endschema %}
{%- comment -%}
  sections/main-author.liquid

  REQUIRED SETUP (see chat explanation):
  1. A blog with handle `authors` must exist.
  2. Each author is one Article inside that blog:
       - handle  -> becomes the author's URL slug (e.g. "jordan")
       - title   -> the author's display name AND the matching key
       - image   -> author avatar
       - content -> author bio (rich text)
     Optional: metafields.custom.author_match_name (string) to decouple
     the matching key from the display title, and
     metafields.custom.author_role (string) for a job title / tagline.
  3. Assign this section to that blog's article template
     (templates/article.authors.json).
  4. On every real blog post, the native "Author" field must match the
     author's title (or author_match_name) EXACTLY.

  This section renders nothing meaningful unless `article` is in scope
  and lives inside the blog described above.
{%- endcomment -%}

{{ 'main-author.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign width_type = section.settings.section_width
  if width_type == blank
    assign width_class = 'author-section__default-width'
  else
    assign width_class = 'author-section__' | append: width_type
  endif
-%}

<div
  class="author-section {{ width_class }}"
  data-section-type="main-author"
  id="author-section-{{ section.id }}"
  style="
    --section-padding: {{ section.settings.section_padding }}px;
    {%- if width_type == 'custom-width' %}
      --custom-width: {{ section.settings.custom_width }}rem;
    {%- endif %}
  "
>
  {%- if article -%}
    {%- assign author_name = article.metafields.custom.author_match_name | default: article.title -%}
    {%- assign current_blog_handle = article.blog.handle -%}

    <header class="author-section__header">
      {%- if section.settings.show_avatar -%}
        <div class="author-section__avatar-wrapper">
          {%- if article.image -%}
            <img
              src="{{ article.image | image_url: width: 400 }}"
              srcset="{{ article.image | image_url: width: 200 }} 200w, {{ article.image | image_url: width: 400 }} 400w"
              sizes="120px"
              alt="{{ article.image.alt | default: author_name | escape }}"
              class="author-section__avatar"
              width="{{ article.image.width }}"
              height="{{ article.image.height }}"
              loading="eager"
            >
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'author-section__avatar author-section__avatar--placeholder' }}
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="author-section__intro">
        <h1 class="author-section__name">
          {{ section.settings.heading | default: author_name }}
        </h1>

        {%- if article.metafields.custom.author_role != blank -%}
          <p class="author-section__role">{{ article.metafields.custom.author_role }}</p>
        {%- endif -%}

        {%- if section.settings.show_bio and article.content != blank -%}
          <div class="author-section__bio">{{ article.content }}</div>
        {%- endif -%}
      </div>
    </header>

    {%- comment -%} ---- Gather this author's articles across the store ---- {%- endcomment -%}
    {%- assign matched = blank -%}
    {%- assign has_seed = false -%}

    {%- if section.settings.search_all_blogs -%}
      {%- for blog in blogs -%}
        {%- unless blog.handle == current_blog_handle -%}
          {%- assign blog_matches = blog.articles | where: "author", author_name -%}
          {%- if blog_matches.size > 0 -%}
            {%- if has_seed -%}
              {%- assign matched = matched | concat: blog_matches -%}
            {%- else -%}
              {%- assign matched = blog_matches -%}
              {%- assign has_seed = true -%}
            {%- endif -%}
          {%- endif -%}
        {%- endunless -%}
      {%- endfor -%}
    {%- elsif section.settings.specific_blog != blank -%}
      {%- assign matched = section.settings.specific_blog.articles | where: "author", author_name -%}
    {%- endif -%}

    {%- assign matched = matched | sort: "published_at" | reverse -%}
    {%- comment -%} Hard cap so a prolific author doesn't blow up the DOM. {%- endcomment -%}
    {%- assign matched = matched | slice: 0, 60 -%}

    <div class="author-section__articles">
      <h2 class="author-section__articles-heading">
        {{ section.settings.articles_heading }}
      </h2>

      {%- if matched.size > 0 -%}
        <div class="author-section__grid" data-author-grid>
          {%- for a in matched -%}
            <div
              class="author-section__grid-item"
              data-author-card
              {%- if forloop.index > section.settings.per_page %} hidden{% endif -%}
            >
              {%- render 'article-card', article: a, loading: forloop.index %}
            </div>
          {%- endfor -%}
        </div>

        {%- if matched.size > section.settings.per_page -%}
          <button
            type="button"
            class="author-section__load-more"
            data-author-load-more
            data-increment="{{ section.settings.load_more_increment }}"
          >
            Load more
          </button>
        {%- endif -%}
      {%- else -%}
        <p class="author-section__empty">{{ section.settings.empty_state_text }}</p>
      {%- endif -%}
    </div>
  {%- else -%}
    <div class="author-section__empty author-section__empty--config">
      This section only works on an Author page — an article inside the
      blog described in the setup comment at the top of this file.
    </div>
  {%- endif -%}
</div>

<script src="{{ 'main-author.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Main author",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override",
      "info": "Leave blank to use the author's title automatically."
    },
    {
      "type": "checkbox",
      "id": "show_avatar",
      "label": "Show avatar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_bio",
      "label": "Show bio",
      "default": true
    },
    {
      "type": "text",
      "id": "articles_heading",
      "label": "Articles heading",
      "default": "Latest articles"
    },
    {
      "type": "checkbox",
      "id": "search_all_blogs",
      "label": "Search all blogs for this author's posts",
      "default": true
    },
    {
      "type": "blog",
      "id": "specific_blog",
      "label": "Or limit to a specific blog",
      "info": "Only used when \"Search all blogs\" is off."
    },
    {
      "type": "range",
      "id": "per_page",
      "min": 3,
      "max": 24,
      "step": 3,
      "label": "Articles shown initially",
      "default": 9
    },
    {
      "type": "range",
      "id": "load_more_increment",
      "min": 3,
      "max": 12,
      "step": 3,
      "label": "Articles revealed per \"Load more\" click",
      "default": 6
    },
    {
      "type": "text",
      "id": "empty_state_text",
      "label": "Empty state message",
      "default": "No articles published yet."
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Main author"
    }
  ]
}
{% endschema %}{%- comment -%}


{%- comment -%} sections/main-search.liquid {%- endcomment -%}
{{ 'main-search.css' | asset_url | stylesheet_tag }}
{{ 'product-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign active_type = 'product'
  if search.types contains 'article'
    assign active_type = 'article'
  endif

  assign type_from_url = request.query_parameters['type'] | default: ''
  if type_from_url == 'article'
    assign active_type = 'article'
  endif

  assign search_terms = search.terms
  assign results_count = search.results_count | default: 0

  assign show_filters = false
  if section.settings.show_filters
    assign show_filters = true
  endif

  assign width_type = section.settings.section_width
  if width_type == blank
    assign width_class = 'search-page__default-width'
  elsif width_type == 'full-width'
    assign width_class = 'search-page__full-width'
  else
    assign width_class = 'search-page__custom-width'
  endif
-%}

<div class="main-search" id="main-search" data-section-id="{{ section.id }}">

  <div
    class="search-page {{ width_class }}"
    data-search-page
    data-active-type="{{ active_type }}"
    style="
      --section-padding: {{ section.settings.section_padding }}px;
      {%- if width_type == 'custom-width' %}
        --custom-width: {{ section.settings.custom_width | default: 80 | at_least: 40 }}rem;
      {%- endif %}
    "
  >

    <div class="search-hero" id="search-hero">
      {%- if search.performed -%}
        <h1 class="search-title">Search results</h1>
        {%- if search_terms != blank -%}
          <p class="search-result-count" id="search-result-count">
            {{ results_count }} result{% if results_count != 1 %}s{% endif %} for &ldquo;{{ search_terms }}&rdquo;
          </p>
        {%- endif -%}
      {%- else -%}
        <h1 class="search-title">Search</h1>
      {%- endif -%}
    </div>

    {%- if search.performed -%}

      <section class="search-section">

        {%- render 'search-toolbar', search_terms: search_terms, active_type: active_type, show_filters: show_filters, section: section -%}

        <div class="search-body{% unless show_filters %} search-body--filters-hidden{% endunless %}" data-search-body>

          {%- if section.settings.show_filters -%}
            {%- render 'search-filter', search_terms: search_terms, active_type: active_type, show_filters: show_filters -%}
          {%- endif -%}

          <div class="search-body__feed">
            {%- render 'search-results', search_terms: search_terms, active_type: active_type, section: section -%}
          </div>

        </div>

      </section>

    {%- else -%}

      <div class="search-hero__prompt">
        <p>Enter a search term above to get started.</p>
      </div>

    {%- endif -%}

  </div>

  <div class="search-mobile-backdrop" aria-hidden="true"></div>

</div>

<script src="{{ 'main-search.js' | asset_url }}" defer></script>
<script src="{{ 'product-card.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Main search",
  "tag": "section",
  "class": "section-search",
  "settings": [
    {
      "type": "text",
      "id": "tab_products_label",
      "label": "Products tab label",
      "default": "Products"
    },
    {
      "type": "text",
      "id": "tab_articles_label",
      "label": "Articles tab label",
      "default": "Articles"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "results_per_page",
      "label": "Results per page",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 16
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "info": "How many product cards per row on small screens (480px and below).",
      "options": [
        { "value": "1", "label": "1 product per row" },
        { "value": "2", "label": "2 products per row" }
      ],
      "default": "1"
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show filters (Products tab only)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show sort (Products tab only)",
      "default": true
    },
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "checkbox",
      "id": "ajax_navigation",
      "label": "Load results without a page refresh",
      "info": "Switches Products/Articles tabs and sort via AJAX instead of reloading the page. Falls back to normal links if JavaScript is unavailable. Filter pills still trigger a full reload for now.",
      "default": false
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "In-feed banners"
    },
    {
      "type": "paragraph",
      "content": "Add 'In-feed banner' blocks below to place promotional banners inside the product results grid. Each banner has its own position number and size — set both per block. Products-tab only; banners are not shown in article results."
    },
    {
      "type": "header",
      "content": "Promo carousels"
    },
    {
      "type": "paragraph",
      "content": "Add a 'Promo carousel' block to insert a product carousel into the product results grid. Set its collection directly on the block. Products-tab only; carousels are not shown in article results."
    }
  ],
  "blocks": [
    {
      "type": "promo_banner",
      "name": "Promo Banner",
      "settings": [
        {
          "type": "number",
          "id": "position",
          "label": "Position in results grid",
          "info": "Banner appears before the Nth product result (counted across the whole result set, not per page). A number larger than the total result count places it at the end of the last page. Leave blank or 0 to hide."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (desktop)"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Image (mobile)",
          "info": "Optional. Falls back to the desktop image if not set."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Makes the entire banner clickable"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#ffffff"
        },
        {
          "type": "select",
          "id": "content_alignment",
          "label": "Content alignment",
          "info": "Aligns the heading, subheading, and button together",
          "options": [
            { "value": "left",   "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right",  "label": "Right" }
          ],
          "default": "left"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Image overlay darkness",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "default": 20
        },
        {
          "type": "header",
          "content": "Size"
        },
        {
          "type": "range",
          "id": "column_span",
          "label": "Width (columns spanned)",
          "min": 1,
          "max": 4,
          "step": 1,
          "default": 2,
          "info": "Capped automatically on smaller screens so it never exceeds the live column count"
        },
        {
          "type": "range",
          "id": "row_span",
          "label": "Height (rows spanned)",
          "min": 1,
          "max": 3,
          "step": 1,
          "default": 1
        }
      ]
    },
    {
      "type": "promo_carousel",
      "name": "Promo carousel",
      "settings": [
        {
          "type": "number",
          "id": "position",
          "label": "Position in results grid",
          "info": "Carousel appears before the Nth product result (counted across the whole result set, not per page). A number larger than the total result count places it at the end of the last page. Leave blank or 0 to hide."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "header",
          "content": "Products"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "range",
          "id": "products_limit",
          "label": "Products to show",
          "min": 4,
          "max": 24,
          "step": 1,
          "default": 12
        },
        {
          "type": "range",
          "id": "cards_per_row_desktop",
          "label": "Cards per row (desktop)",
          "min": 2,
          "max": 5,
          "step": 1,
          "default": 3
        },
        {
          "type": "range",
          "id": "cards_per_row_mobile",
          "label": "Cards per row (mobile)",
          "min": 1,
          "max": 3,
          "step": 1,
          "default": 2
        },
        {
          "type": "checkbox",
          "id": "show_arrows",
          "label": "Show arrows",
          "default": true
        },
        {
          "type": "select",
          "id": "arrow_position",
          "label": "Arrow position",
          "options": [
            { "value": "top", "label": "Top" },
            { "value": "bottom", "label": "Bottom" },
            { "value": "side", "label": "Side" }
          ],
          "default": "bottom"
        },
        {
          "type": "checkbox",
          "id": "autoplay",
          "label": "Autoplay",
          "default": false
        },
        {
          "type": "range",
          "id": "autoplay_interval",
          "label": "Autoplay interval (seconds)",
          "min": 2,
          "max": 10,
          "step": 1,
          "default": 4
        },
        {
          "type": "header",
          "content": "Banner"
        },
        {
          "type": "checkbox",
          "id": "show_banner",
          "label": "Show side banner",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "banner_image",
          "label": "Banner image"
        },
        {
          "type": "url",
          "id": "banner_link",
          "label": "Banner link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Main search"
    }
  ]
}
{% endschema %}
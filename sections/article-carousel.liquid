{%- comment -%}
  sections/article-carousel.liquid

  A horizontally-scrolling row of article-card.liquid snippets, with a
  heading and optional "view all" link (see the "Latest" reference), and
  prev/next controls once the row overflows.

  Two ways to source articles:
  - "blog"   -> pulls the N most recent articles from a chosen blog
               (use this for a "Latest" style section)
  - "manual" -> uses the "article" blocks added in the theme editor, in
               the order they're arranged there (use this for a curated
               "Popular Articles" style section)

  SECTION LAYOUT: this section's width/padding controls follow the
  pattern from sections/example-width-section.liquid — local
  --section-padding / --custom-width CSS variables set inline from
  this section's own settings, independent of the global
  --page-margin / --page-width variables. See that file's header
  comment for the full rationale.
{%- endcomment -%}

{%- liquid
  assign source = section.settings.source
  assign heading = section.settings.heading
  assign show_view_all = section.settings.show_view_all
  assign view_all_label = section.settings.view_all_label
  assign articles_to_show = section.settings.articles_to_show

  assign width_type = section.settings.section_width
  if width_type == blank
    assign width_class = 'article-carousel__default-width'
  else
    assign width_class = 'article-carousel__' | append: width_type
  endif
-%}

<section class="article-carousel color-{{ section.settings.color_scheme }}" data-section-id="{{ section.id }}">
  <div
    class="article-carousel__container {{ width_class }}"
    style="
      --section-padding: {{ section.settings.section_padding }}px;
      {%- if width_type == 'custom-width' %}
        --custom-width: {{ section.settings.custom_width }}rem;
      {%- endif %}
    "
  >

    {%- if heading != blank or show_view_all -%}
      <div class="article-carousel__header">
        {%- if heading != blank -%}
          <h2 class="article-carousel__heading">{{ heading }}</h2>
        {%- endif -%}

        {%- if show_view_all and source == 'blog' and section.settings.blog != blank -%}
          <a href="{{ section.settings.blog.url }}" class="article-carousel__view-all">
            {{ view_all_label | default: 'See all' }}
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
              <path d="M3.5 8h9m0 0L8.5 4m4 4L8.5 12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- elsif show_view_all and section.settings.view_all_url != blank -%}
          <a href="{{ section.settings.view_all_url }}" class="article-carousel__view-all">
            {{ view_all_label | default: 'See all' }}
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
              <path d="M3.5 8h9m0 0L8.5 4m4 4L8.5 12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="article-carousel__viewport" data-carousel-viewport>
      <ul class="article-carousel__track" data-carousel-track role="list">

        {%- if source == 'manual' -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'article' and block.settings.article != blank -%}
              {%- if forloop.index0 < 2 -%}
                {%- assign card_loading = 'eager' -%}
              {%- else -%}
                {%- assign card_loading = 'lazy' -%}
              {%- endif -%}
              <li class="article-carousel__slide" {{ block.shopify_attributes }}>
                {%- render 'article-card', article: block.settings.article, loading: card_loading -%}
              </li>
            {%- endif -%}
          {%- endfor -%}

        {%- else -%}
          {%- if section.settings.blog != blank -%}
            {%- assign blog = section.settings.blog -%}
            {%- for article in blog.articles limit: articles_to_show -%}
              {%- if forloop.index0 < 2 -%}
                {%- assign card_loading = 'eager' -%}
              {%- else -%}
                {%- assign card_loading = 'lazy' -%}
              {%- endif -%}
              <li class="article-carousel__slide">
                {%- render 'article-card', article: article, loading: card_loading -%}
              </li>
            {%- endfor -%}
          {%- endif -%}
        {%- endif -%}

      </ul>

      <div class="article-carousel__controls" data-carousel-controls hidden>
        <button type="button" class="article-carousel__arrow article-carousel__arrow--prev" data-carousel-prev aria-label="Previous articles">
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
            <path d="M12.5 8h-9m0 0L7.5 4m-4 4l4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button type="button" class="article-carousel__arrow article-carousel__arrow--next" data-carousel-next aria-label="Next articles">
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
            <path d="M3.5 8h9m0 0L8.5 4m4 4L8.5 12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>

  </div>
</section>

{{ 'article-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'article-carousel.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Article carousel",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Popular Articles"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "inverse", "label": "Inverse" }
      ],
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "select",
      "id": "source",
      "label": "Articles source",
      "options": [
        { "value": "blog", "label": "Automatic (latest from a blog)" },
        { "value": "manual", "label": "Manual (choose articles below)" }
      ],
      "default": "blog"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Used when the source above is set to Automatic."
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "label": "Articles to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8,
      "info": "Used when the source above is set to Automatic."
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show \"See all\" link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "\"See all\" link text",
      "default": "See all"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "\"See all\" link URL",
      "info": "Used when the source above is set to Manual, or no blog is chosen."
    }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "Article",
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Article"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Article carousel",
      "blocks": [
        { "type": "article" },
        { "type": "article" },
        { "type": "article" },
        { "type": "article" }
      ]
    }
  ]
}
{% endschema %}
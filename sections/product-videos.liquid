{%- comment -%}
  sections/product-videos.liquid
  ============================================
  Split from the original monolithic videos.liquid. This section now
  owns only the carousel shell (heading, track, arrows) and hands each
  slot's markup off to snippets/video-card.liquid. Playback has moved
  out of the slot entirely and into one shared lightbox — see
  snippets/video-modal.liquid — instead of each card revealing its own
  inline <video>/iframe.

  Files involved:
    - assets/product-videos.css / .js  → carousel shell only (this file)
    - snippets/video-card.liquid + assets/video-card.css / .js → per-slot thumbnail + play trigger
    - snippets/video-modal.liquid + assets/video-modal.css / .js → shared lightbox, rendered once below

  NOTE: video-modal is rendered once, at the bottom of this section.
  If a page ever has more than one Videos section on it, only one of
  them needs to render the modal — video-modal.js will remove
  duplicates if it finds them, but don't rely on that; see the note in
  video-modal.liquid.
{%- endcomment -%}
<link rel="stylesheet" href="{{ 'product-videos.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'video-card.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'video-modal.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>
  <link rel="stylesheet" href="{{ 'product-videos.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'video-card.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'video-modal.css' | asset_url }}">
</noscript>
<script src="{{ 'product-videos.js' | asset_url }}" defer></script>
<script src="{{ 'video-card.js' | asset_url }}" defer></script>
<script src="{{ 'video-modal.js' | asset_url }}" defer></script>

{%- liquid
  assign placeholder_names = 'lifestyle-1,lifestyle-2,product-1,product-2,product-3,product-4' | split: ','
-%}

<div
  {% render 'section-width', section: section, extra_class: 'product-videos' %}
  id="ProductVideos-{{ section.id }}"
  data-product-videos
>

  {%- if section.settings.heading != blank -%}
    <div class="product-videos__header">
      <h2 class="product-videos__heading">{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="product-videos__carousel" data-video-carousel>

      <button
        type="button"
        class="product-videos__arrow product-videos__arrow--prev"
        data-video-prev
        aria-label="Previous videos"
        aria-controls="VideoTrack-{{ section.id }}"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div
        class="product-videos__track"
        id="VideoTrack-{{ section.id }}"
        data-video-track
        role="list"
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign item_index = forloop.index0
            assign placeholder_name = placeholder_names[item_index]
            if placeholder_name == blank
              assign placeholder_name = 'lifestyle-1'
            endif
          -%}
          <div
            class="product-videos__item"
            id="VideoItem-{{ block.id }}"
            data-video-item
            role="listitem"
            {{ block.shopify_attributes }}
          >
            {%- render 'video-card',
              block: block,
              placeholder_name: placeholder_name,
              show_caption: section.settings.show_caption
            -%}
          </div>
        {%- endfor -%}
      </div>

      <button
        type="button"
        class="product-videos__arrow product-videos__arrow--next"
        data-video-next
        aria-label="Next videos"
        aria-controls="VideoTrack-{{ section.id }}"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

    </div>
  {%- endif -%}

</div>

{%- render 'video-modal' -%}

{% schema %}
{
  "name": "Product Videos",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Watch & shop"
    },
    {
      "type": "checkbox",
      "id": "show_caption",
      "label": "Show video captions",
      "default": true
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Upload a video file. Takes priority over an external video link."
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "External video link",
          "accept": ["youtube", "vimeo"],
          "info": "Used only if no video file is uploaded above."
        },
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Thumbnail",
          "info": "If left blank, uses the uploaded video's preview image, or a placeholder."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Videos",
      "blocks": [
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}

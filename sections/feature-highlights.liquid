{%- comment -%}
  sections/feature-highlights.liquid
  ============================================
  Metafield-driven image carousel for feature callouts.

  Highlights are pulled directly from the product's
  `custom.featured_highlights` metafield (List of metaobject references,
  type `featured_highlight`) — NOT from theme blocks. There is nothing
  to configure in the theme editor for which highlights show; whatever
  is assigned to the product's metafield is what renders, in that order.

  If the product has no metafield value, or this section is rendered
  outside product context, this renders NOTHING — no wrapper markup,
  no CSS/JS asset requests.

  No video, no lightbox — fully independent of the video-section/
  video-card/video-modal files.

  Files involved:
    - assets/feature-highlights.css     → carousel shell + card visuals
    - assets/feature-highlights.js      → carousel arrow/scroll behavior only
    - snippets/feature-highlight-card.liquid → reads metaobject fields
{%- endcomment -%}

{%- liquid
  assign highlights = blank
  if product
    assign highlights = product.metafields.custom.featured_highlights.value
  endif
-%}

{%- if highlights != blank and highlights.size > 0 -%}
  <link rel="stylesheet" href="{{ 'feature-highlights.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript>
    <link rel="stylesheet" href="{{ 'feature-highlights.css' | asset_url }}">
  </noscript>
  <script src="{{ 'feature-highlights.js' | asset_url }}" defer></script>

  <div
    {% render 'section-width', section: section, extra_class: 'feature-highlights' %}
    id="FeatureHighlights-{{ section.id }}"
    data-feature-highlights
  >

    {%- if section.settings.heading != blank -%}
      <div class="feature-highlights__header">
        <h2 class="feature-highlights__heading">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="feature-highlights__carousel" data-feature-carousel>

      <button
        type="button"
        class="feature-highlights__arrow feature-highlights__arrow--prev"
        data-feature-prev
        aria-label="Previous features"
        aria-controls="FeatureTrack-{{ section.id }}"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div
        class="feature-highlights__track"
        id="FeatureTrack-{{ section.id }}"
        data-feature-track
        role="list"
      >
        {%- for highlight in highlights -%}
          <div
            class="feature-highlights__item"
            id="Feature-{{ highlight.id | split: '/' | last }}"
            data-feature-item
            role="listitem"
          >
            {%- render 'feature-highlight-card', highlight: highlight -%}
          </div>
        {%- endfor -%}
      </div>

      <button
        type="button"
        class="feature-highlights__arrow feature-highlights__arrow--next"
        data-feature-next
        aria-label="Next features"
        aria-controls="FeatureTrack-{{ section.id }}"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Feature Highlights",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Technical Specifications"
    },
    {
      "type": "paragraph",
      "content": "Highlights are pulled automatically from this product's Featured highlights metafield. Assign entries to the product to control what shows here."
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Feature Highlights"
    }
  ]
}
{% endschema %}

{% comment %}
  =========================================================
  sections/slideshow.liquid — Shopify 2.0 Compatible
  Supports: Collection, Product, Blog, Page, URL links
  Placeholder-friendly: uses placeholder_svg_tag when no
  image is set, swaps to real image when one is uploaded.

  Built from two references:
  - sections/example-width-section.liquid, for the
    "Section Layout" width/padding controls. This section
    owns its width via --section-padding / --custom-width,
    set inline per-instance. It never reads the theme's
    global --page-margin / --page-width, so bumping the
    global Body side padding setting can't break this
    section's layout.
  - The original image-carousel section, for the Swiper
    markup, block schema, and placeholder handling. Styles
    were moved out of an inline {% style %} block into
    assets/slideshow.css since none of them actually need
    {{ section.id }} scoping — every per-instance value is
    passed through CSS custom properties instead.

  ADOPTED BY (sections using the width/padding pattern):
  - sections/video-carousel.liquid ("Watch & learn")
  - sections/slideshow.liquid (this file)
  =========================================================
{% endcomment %}

{{ 'slideshow.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

{%- liquid
  assign width_type = section.settings.section_width
  if width_type == blank
    assign width_class = 'slideshow__default-width'
  else
    assign width_class = 'slideshow__' | append: width_type
  endif
-%}

<div
  class="slideshow-section {{ width_class }}"
  style="
    --slide-height: {{ section.settings.slide_height }}px;
    --slide-height-mobile: {{ section.settings.slide_height_mobile }}px;
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --dot-color: {{ section.settings.dot_color }};
    --nav-bg: {{ section.settings.nav_bg_color }};
    --nav-icon: {{ section.settings.nav_icon_color }};
    --section-padding: {{ section.settings.section_padding }}px;
    {%- if width_type == 'custom-width' %}
      --custom-width: {{ section.settings.custom_width }}rem;
    {%- endif %}
  "
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.autoplay_speed }}"
  data-loop="{{ section.settings.loop }}"
  data-effect="{{ section.settings.transition_effect }}"
>
  <div
    class="swiper slideshow-swiper-{{ section.id }}"
    aria-label="{{ section.settings.accessibility_label | escape }}"
  >
    <div class="swiper-wrapper">

      {% for block in section.blocks %}
        {% assign block_link = '' %}

        {%- case block.settings.link_type -%}
          {%- when 'collection' -%}
            {% if block.settings.link_collection != blank %}
              {% assign block_link = block.settings.link_collection.url %}
            {% endif %}
          {%- when 'product' -%}
            {% if block.settings.link_product != blank %}
              {% assign block_link = block.settings.link_product.url %}
            {% endif %}
          {%- when 'blog' -%}
            {% if block.settings.link_blog != blank %}
              {% assign block_link = block.settings.link_blog.url %}
            {% endif %}
          {%- when 'page' -%}
            {% if block.settings.link_page != blank %}
              {% assign block_link = block.settings.link_page.url %}
            {% endif %}
          {%- when 'url' -%}
            {% assign block_link = block.settings.link_url %}
        {%- endcase -%}

        {% if block_link != blank %}
          <a
            class="swiper-slide"
            href="{{ block_link }}"
            {% if block.settings.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
            {{ block.shopify_attributes }}
            role="group"
            aria-label="Slide {{ forloop.index }}: {{ block.settings.heading | default: 'Image slide' }}"
          >
        {% else %}
          <div
            class="swiper-slide"
            {{ block.shopify_attributes }}
            role="group"
            aria-label="Slide {{ forloop.index }}: {{ block.settings.heading | default: 'Image slide' }}"
          >
        {% endif %}

          {% comment %} ── Image or placeholder ── {% endcomment %}
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 1800
              | image_tag:
                loading: 'lazy',
                class: 'slide-img',
                widths: '480, 768, 1024, 1440, 1800',
                sizes: '100vw',
                alt: block.settings.image.alt | default: block.settings.heading
            }}
          {% else %}
            <div class="slide-placeholder" aria-hidden="true">
              {{ 'lifestyle-1' | placeholder_svg_tag }}
            </div>
          {% endif %}

          {% comment %} ── Overlay ── {% endcomment %}
          <div class="slide-overlay" aria-hidden="true"></div>

          {% comment %} ── Text ── {% endcomment %}
          {% if block.settings.eyebrow != blank
            or block.settings.heading != blank
            or block.settings.subtext != blank
            or block.settings.cta_label != blank
          %}
            <div class="slide-content">
              {% if block.settings.eyebrow != blank %}
                <p class="slide-eyebrow">{{ block.settings.eyebrow }}</p>
              {% endif %}
              {% if block.settings.heading != blank %}
                <h2 class="slide-heading">{{ block.settings.heading }}</h2>
              {% endif %}
              {% if block.settings.subtext != blank %}
                <p class="slide-subtext">{{ block.settings.subtext }}</p>
              {% endif %}
              {% if block.settings.cta_label != blank and block_link != blank %}
                <span class="slide-cta" aria-hidden="true">{{ block.settings.cta_label }}</span>
              {% endif %}
            </div>
          {% endif %}

        {% if block_link != blank %}
          </a>
        {% else %}
          </div>
        {% endif %}

      {% else %}
        {% comment %} ── Fallback: no blocks added yet ── {% endcomment %}
        {% for i in (1..3) %}
          <div class="swiper-slide" role="group" aria-label="Placeholder slide {{ i }}">
            <div class="slide-placeholder" aria-hidden="true">
              {{ 'lifestyle-' | append: i | placeholder_svg_tag }}
            </div>
            <div class="slide-overlay" aria-hidden="true"></div>
            <div class="slide-content">
              <p class="slide-eyebrow">New collection</p>
              <h2 class="slide-heading">Add your slide heading</h2>
              <p class="slide-subtext">Update this slide in the theme editor to add an image, heading, and link.</p>
            </div>
          </div>
        {% endfor %}
      {% endfor %}

    </div><!-- /swiper-wrapper -->

    {% if section.settings.show_navigation %}
      <div class="swiper-button-prev" aria-label="Previous slide"></div>
      <div class="swiper-button-next" aria-label="Next slide"></div>
    {% endif %}

    {% if section.settings.show_pagination %}
      <div class="swiper-pagination" role="tablist" aria-label="Slideshow slides"></div>
    {% endif %}
  </div><!-- /swiper -->
</div><!-- /slideshow-section -->

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var el = document.querySelector('.slideshow-swiper-{{ section.id }}');
    if (!el) return;

    var wrapper = el.closest('.slideshow-section');

    new Swiper('.slideshow-swiper-{{ section.id }}', {
      loop:            wrapper.dataset.loop   === 'true',
      effect:          wrapper.dataset.effect || 'slide',
      speed:           600,
      autoplay: wrapper.dataset.autoplay === 'true' ? {
        delay:            parseInt(wrapper.dataset.speed, 10) || 4000,
        disableOnInteraction: false,
        pauseOnMouseEnter:    true
      } : false,
      navigation: {
        nextEl: '.slideshow-swiper-{{ section.id }} .swiper-button-next',
        prevEl: '.slideshow-swiper-{{ section.id }} .swiper-button-prev'
      },
      pagination: {
        el:        '.slideshow-swiper-{{ section.id }} .swiper-pagination',
        clickable: true
      },
      a11y: {
        prevSlideMessage: 'Previous slide',
        nextSlideMessage: 'Next slide'
      },
      keyboard: { enabled: true },
    });
  });
</script>

{% schema %}
{
  "name": "Slideshow",
  "tag": "section",
  "class": "slideshow",
  "max_blocks": 10,
  "settings": [
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Slide size"
    },
    {
      "type": "range",
      "id": "slide_height",
      "label": "Slide height (desktop)",
      "min": 300,
      "max": 900,
      "step": 20,
      "default": 600,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "slide_height_mobile",
      "label": "Slide height (mobile)",
      "min": 200,
      "max": 600,
      "step": 20,
      "default": 380,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay delay",
      "min": 2000,
      "max": 9000,
      "step": 500,
      "default": 5000,
      "unit": "ms"
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop slides",
      "default": true
    },
    {
      "type": "select",
      "id": "transition_effect",
      "label": "Transition effect",
      "options": [
        { "value": "slide", "label": "Slide" },
        { "value": "fade",  "label": "Fade" }
      ],
      "default": "slide"
    },
    {
      "type": "header",
      "content": "Controls"
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show prev/next arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show pagination dots",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 35,
      "unit": "%"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / CTA color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Pagination dot color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "nav_bg_color",
      "label": "Arrow background",
      "default": "rgba(255,255,255,0.25)"
    },
    {
      "type": "color",
      "id": "nav_icon_color",
      "label": "Arrow icon color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Accessibility"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Slideshow aria-label",
      "default": "Featured content"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "header",
          "content": "Image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Recommended: 1800 × 900 px. Leave blank to use placeholder."
        },
        {
          "type": "header",
          "content": "Text overlay"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow (small label above heading)",
          "placeholder": "e.g. New arrivals"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "placeholder": "e.g. Summer Edit"
        },
        {
          "type": "textarea",
          "id": "subtext",
          "label": "Subtext",
          "placeholder": "Optional supporting sentence."
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA button label",
          "placeholder": "e.g. Shop now"
        },
        {
          "type": "header",
          "content": "Link destination"
        },
        {
          "type": "select",
          "id": "link_type",
          "label": "Link type",
          "options": [
            { "value": "none",       "label": "No link" },
            { "value": "collection", "label": "Collection" },
            { "value": "product",    "label": "Product" },
            { "value": "blog",       "label": "Blog" },
            { "value": "page",       "label": "Page" },
            { "value": "url",        "label": "Custom URL" }
          ],
          "default": "none"
        },
        {
          "type": "collection",
          "id": "link_collection",
          "label": "Collection",
          "info": "Active when Link type = Collection"
        },
        {
          "type": "product",
          "id": "link_product",
          "label": "Product",
          "info": "Active when Link type = Product"
        },
        {
          "type": "blog",
          "id": "link_blog",
          "label": "Blog",
          "info": "Active when Link type = Blog"
        },
        {
          "type": "page",
          "id": "link_page",
          "label": "Page",
          "info": "Active when Link type = Page"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Custom URL",
          "info": "Active when Link type = Custom URL"
        },
        {
          "type": "checkbox",
          "id": "open_new_tab",
          "label": "Open link in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slideshow",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "eyebrow": "New arrivals",
            "heading": "Summer Edit",
            "subtext": "Fresh styles just landed — explore the full collection.",
            "cta_label": "Shop now",
            "link_type": "collection"
          }
        },
        {
          "type": "slide",
          "settings": {
            "eyebrow": "Staff pick",
            "heading": "Featured Product",
            "cta_label": "View product",
            "link_type": "product"
          }
        },
        {
          "type": "slide",
          "settings": {
            "eyebrow": "From the journal",
            "heading": "Style Notes",
            "cta_label": "Read more",
            "link_type": "blog"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{%- comment -%}
  sections/featured-articles.liquid

  Renders a curated "Featured blogs" list using the ARTICLE-level
  metafield custom.featured_articles (type: List of Blog post
  references). This metafield is defined on individual blog posts,
  not on the shop — each article picks its own featured reads in
  the article editor.

  Metafield-only: there is no blog/latest-posts fallback. If the
  metafield is empty or unset on the current article, this section
  renders nothing at all (not even its wrapper div), so it never
  shows an empty box.

  Because it depends on `article`, this only works when placed on
  an article page. The schema's "enabled_on" restricts it to
  templates/article.json in the theme editor.
{%- endcomment -%}

{%- liquid
  assign featured_mf = article.metafields.custom.featured_articles
  assign articles = blank
  assign articles_count = 0

  if featured_mf != blank and featured_mf.value != blank
    assign articles = featured_mf.value | reject: 'id', article.id
    assign articles_count = articles.size
  endif
-%}

{%- if articles_count > 0 -%}
  {{ 'featured-articles.css' | asset_url | stylesheet_tag }}

  {%- liquid
    assign articles_to_show = section.settings.articles_to_show
    assign width_type = section.settings.section_width
    if width_type == blank
      assign width_class = 'featured-articles__default-width'
    else
      assign width_class = 'featured-articles__' | append: width_type
    endif
  -%}

  <div
    class="featured-articles color-{{ section.settings.color_scheme }} {{ width_class }}"
    id="FeaturedArticles-{{ section.id }}"
    style="
      --section-padding: {{ section.settings.section_padding }}px;
      {%- if width_type == 'custom-width' %}
        --custom-width: {{ section.settings.custom_width }}rem;
      {%- endif %}
    "
  >
    <div class="featured-articles__container">

      {%- if section.settings.heading != blank -%}
        <h2 class="featured-articles__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="featured-articles__viewport" data-carousel-viewport>
        <ul class="featured-articles__track" id="FeaturedArticlesTrack-{{ section.id }}" data-carousel-track role="list">
          {%- for article in articles limit: articles_to_show -%}
            <li class="featured-articles__slide">
              <a href="{{ article.url }}" class="featured-articles__card" aria-label="{{ article.title | escape }}">
                <div class="featured-articles__image-wrapper">
                  {%- if article.image -%}
                    <img
                      src="{{ article.image | image_url: width: 700 }}"
                      srcset="{{ article.image | image_url: width: 400 }} 400w, {{ article.image | image_url: width: 700 }} 700w, {{ article.image | image_url: width: 1000 }} 1000w"
                      sizes="(min-width: 990px) 33vw, (min-width: 750px) 50vw, 85vw"
                      alt="{{ article.image.alt | default: article.title | escape }}"
                      loading="lazy"
                      width="{{ article.image.width }}"
                      height="{{ article.image.height }}"
                      class="featured-articles__image"
                    >
                  {%- else -%}
                    <div class="featured-articles__image featured-articles__image--placeholder">
                      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  {%- endif -%}
                </div>
                <h3 class="featured-articles__title">{{ article.title }}</h3>
              </a>
            </li>
          {%- endfor -%}
        </ul>

        <div class="featured-articles__controls" data-carousel-controls hidden>
          <button type="button" class="featured-articles__arrow featured-articles__arrow--prev" data-carousel-prev aria-label="{{ 'general.slider.previous_slide' | default: 'Previous' }}">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M11 3.5L5.5 9l5.5 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button type="button" class="featured-articles__arrow featured-articles__arrow--next" data-carousel-next aria-label="{{ 'general.slider.next_slide' | default: 'Next' }}">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M7 3.5L12.5 9 7 14.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <script src="{{ 'featured-articles.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Featured blogs",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["article"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the articles selected in this post's \"featured_articles\" metafield (Metafields > Blog post post > featured_articles). If nothing is selected there, this section shows nothing."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured blogs"
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "label": "Number of articles",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Featured blogs"
    }
  ]
}
{% endschema %}
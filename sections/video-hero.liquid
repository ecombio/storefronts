{%- comment -%}
  sections/video-hero.liquid
  ============================================
  Full-bleed hero: background video (Shopify-hosted, via the native
  "video" setting), a poster image fallback, and an optional
  heading/text/button overlay. Self-contained — no dependency on
  video-section.js / video-card.js / video-modal.js, which power the
  separate carousel-style video sections.

  Files involved:
    - assets/video-hero.css
    - assets/video-hero.js  (play/pause toggle, reduced-motion +
      mobile-bandwidth handling, pause-when-offscreen)
{%- endcomment -%}
<link rel="stylesheet" href="{{ 'video-hero.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>
  <link rel="stylesheet" href="{{ 'video-hero.css' | asset_url }}">
</noscript>
<script src="{{ 'video-hero.js' | asset_url }}" defer></script>

{%- liquid
  assign mp4_source = section.settings.video.sources | where: 'format', 'mp4' | last
  assign poster_image = section.settings.poster_image | default: section.settings.video.preview_image
-%}

<div
  class="video-hero video-hero--{{ section.settings.height }} video-hero--content-{{ section.settings.content_position }}"
  id="VideoHero-{{ section.id }}"
  data-video-hero
  data-mobile-enabled="{{ section.settings.enable_video_on_mobile }}"
  style="--overlay-color: {{ section.settings.overlay_color }}; --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --text-color: {{ section.settings.text_color }};"
>

  <div class="video-hero__media">
    {%- if poster_image != blank -%}
      {{
        poster_image
        | image_url: width: 1800
        | image_tag:
          loading: 'eager',
          class: 'video-hero__poster',
          sizes: '100vw',
          widths: '750,1100,1500,1800,2400'
      }}
    {%- endif -%}

    {%- if mp4_source != blank -%}
      <video
        class="video-hero__video"
        data-video-hero-player
        muted
        loop
        playsinline
        preload="none"
        {%- if poster_image != blank %} poster="{{ poster_image | image_url: width: 1800 }}"{% endif -%}
      >
        <source data-src="{{ mp4_source.url }}" type="video/mp4">
      </video>
    {%- endif -%}
  </div>

  <div class="video-hero__overlay"></div>

  {%- if section.settings.heading != blank or section.settings.text != blank or section.settings.button_label != blank -%}
    <div class="video-hero__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="video-hero__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="video-hero__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="video-hero__button"
        >
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if mp4_source != blank -%}
    <button
      type="button"
      class="video-hero__toggle"
      data-video-hero-toggle
      aria-pressed="true"
      aria-label="Pause background video"
    >
      <svg class="video-hero__icon video-hero__icon--pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
        <rect x="6" y="5" width="4" height="14" rx="1" fill="currentColor"/>
        <rect x="14" y="5" width="4" height="14" rx="1" fill="currentColor"/>
      </svg>
      <svg class="video-hero__icon video-hero__icon--play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" hidden>
        <path d="M7 5l12 7-12 7V5z" fill="currentColor"/>
      </svg>
    </button>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "Video Hero",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Upload an MP4. Keep it short and looped (under ~20s) so the file size stays reasonable."
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Poster image",
      "info": "Shown before the video loads, while paused on mobile, and as the fallback if no video is uploaded. Falls back to the video's own thumbnail if left blank."
    },
    {
      "type": "checkbox",
      "id": "enable_video_on_mobile",
      "label": "Play video on mobile",
      "info": "If unchecked, mobile visitors see the poster image only — video is not downloaded, to save data.",
      "default": false
    },
    {
      "type": "header",
      "content": "Content overlay"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "top-right", "label": "Top right" },
        { "value": "middle-left", "label": "Middle left" },
        { "value": "middle-center", "label": "Middle center" },
        { "value": "middle-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "middle-center"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Section height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full-screen", "label": "Full screen" }
      ],
      "default": "large"
    }
  ],
  "presets": [
    {
      "name": "Video Hero"
    }
  ]
}
{% endschema %}

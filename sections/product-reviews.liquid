{%- comment -%}
  sections/product-reviews.liquid

  Standalone reviews section, extracted out of the "Customer Reviews"
  accordion item in sections/product-information.liquid so it can be
  placed, reordered, or hidden independently in the product template.

  Respects the sitewide `settings.reviews_provider` toggle (Yotpo /
  Judge.me), same as snippets/star-rating.liquid and
  snippets/product-card.liquid.
{%- endcomment -%}

{{ 'accordion.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign reviews_provider = settings.reviews_provider | default: 'yotpo'

  assign has_legacy = false
  if product.metafields.judgeme.widget.size > 20
    assign has_legacy = true
  endif
-%}

<div
  {% render 'section-width', section: section, extra_class: 'product-reviews' %}
  id="ProductReviews-{{ section.id }}"
  data-product-reviews
>

  {%- if section.settings.collapsible -%}

    <div class="accordion">
      <details class="accordion__item product-reviews__section" id="reviews-{{ section.id }}" data-section="reviews-{{ section.id }}" open>
        <summary class="accordion__summary">
          {%- if section.settings.heading != blank -%}
            <h2 class="product-reviews__heading">{{ section.settings.heading }}</h2>
          {%- else -%}
            <span class="accordion__summary-spacer"></span>
          {%- endif -%}
          <span class="accordion__icon"></span>
        </summary>
        <div class="accordion__content">
          {%- render 'reviews-widget', product: product, reviews_provider: reviews_provider, has_legacy: has_legacy -%}
        </div>
      </details>
    </div>

  {%- else -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="product-reviews__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- render 'reviews-widget', product: product, reviews_provider: reviews_provider, has_legacy: has_legacy -%}

  {%- endif -%}

</div>

{% schema %}
{
  "name": "Product reviews",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the review app's own built-in title and avoid a duplicate heading."
    },
    {
      "type": "checkbox",
      "id": "collapsible",
      "label": "Collapsible (accordion style)",
      "info": "Matches the style used in Product Information. Turn off to always show reviews expanded.",
      "default": true
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Product reviews"
    }
  ]
}
{% endschema %}
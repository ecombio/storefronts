{%- comment -%}
  sections/menu-block.liquid

  Renders one top-level linklist as a single row of up to four columns.
  Each column = one top-level menu item (as the column heading) plus its
  child links. Items past the 4th top-level entry are ignored for now —
  if you need more columns or multiple rows later, that's a schema change
  (e.g. a "columns" range setting) rather than a markup rewrite.

  Uses the shared width pattern from snippets/section-width.liquid — see
  sections/example-width-section.liquid for the full explanation of that
  pattern. Don't hand-roll width logic here.
{%- endcomment -%}

<div {% render 'section-width', section: section %}>
  <div class="section menu-block" style="padding-block: var(--section-spacing);">
    {%- if section.settings.heading != blank -%}
      <h2 class="menu-block__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.menu != blank -%}
      {%- assign menu = linklists[section.settings.menu] -%}
      <ul class="menu-block__columns" role="list">
        {%- for link in menu.links limit: 4 -%}
          <li class="menu-block__column">
            {%- if link.links.size > 0 -%}
              <h5 class="menu-block__column-title">{{ link.title }}</h5>
              <ul class="menu-block__column-links" role="list">
                {%- for child_link in link.links -%}
                  <li>
                    <a href="{{ child_link.url }}"{% if child_link.active %} aria-current="page"{% endif %}>
                      {{ child_link.title }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- else -%}
              {%- comment -%} No children: the item itself is the link {%- endcomment -%}
              <h5 class="menu-block__column-title">
                <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
              </h5>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

<style>
  .menu-block__heading {
    margin-block-end: 1.5rem;
  }

  .menu-block__columns {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .menu-block__column-title {
    margin: 0 0 0.75rem;
    font-size: 1rem;
  }

  .menu-block__column-title a {
    color: inherit;
    text-decoration: none;
  }

  .menu-block__column-links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .menu-block__column-links li {
    margin-block: 0.4rem;
  }

  .menu-block__column-links a {
    color: inherit;
    text-decoration: none;
  }

  .menu-block__column-links a:hover {
    text-decoration: underline;
  }

  @media screen and (max-width: 749px) {
    .menu-block__columns {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem 2rem;
    }
  }
</style>

{% schema %}
{
  "name": "Menu block",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "info": "Only the first 4 top-level items are shown — one per column. Sub-items under each become that column's link list."
    },
    { "type": "header", "content": "Section layout" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    { "name": "Menu block" }
  ]
}
{% endschema %}
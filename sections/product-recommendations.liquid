{% comment %}
  ╔══════════════════════════════════════════════════════════╗
  ║  sections/product-recommendations.liquid                 ║
  ║                                                            ║
  ║  Core logic:  Shopify's native product recommendations   ║
  ║               (routes.product_recommendations_url,       ║
  ║               intent: related). On a normal page load     ║
  ║               `recommendations` is blank — this section   ║
  ║               renders shimmer placeholders, hidden, and    ║
  ║               product-recommendations.js re-fetches THIS   ║
  ║               section via ?section_id=... so Shopify       ║
  ║               resolves recommendations.products server-   ║
  ║               side and returns fully rendered cards.       ║
  ║                                                            ║
  ║  Cards:       snippets/product-card.liquid, rendered      ║
  ║               directly — same pattern as                  ║
  ║               sections/product-carousel.liquid.            ║
  ║                                                            ║
  ║  Carousel UX: self-contained — assets/product-             ║
  ║               recommendations.css/.js. Does not load or    ║
  ║               depend on product-carousel.css/.js.          ║
  ║                                                            ║
  ║  Assumes product-card.css / product-card.js are already   ║
  ║  loaded globally in theme.liquid (same assumption made     ║
  ║  by product-carousel.liquid) — not re-loaded here.         ║
  ║                                                            ║
  ║  Section layout: width_class + --section-padding follow    ║
  ║  the same pattern as sections/example-width-section.liquid ║
  ║  (also adopted by product-carousel.liquid) — side padding  ║
  ║  is section-local, does not read the global --page-margin. ║
  ║  Vertical padding (--pr-pad-top/bottom) stays separate,    ║
  ║  driven by this section's own existing padding_top/bottom  ║
  ║  settings.                                                  ║
  ╚══════════════════════════════════════════════════════════╝
{% endcomment %}

{%- liquid
  assign heading      = section.settings.heading
  assign subheading    = section.settings.subheading
  assign limit         = section.settings.products_to_show | default: 4
  assign cols_desktop  = section.settings.columns_desktop | default: 4
  assign cols_mobile   = section.settings.columns_mobile | default: '2'
  assign gap           = section.settings.card_gap | default: 16
  assign cs            = section.settings.color_scheme
  assign pad_top       = section.settings.padding_top
  assign pad_bottom    = section.settings.padding_bottom
  assign show_arrows   = section.settings.show_arrows
  assign arrow_position = section.settings.arrow_position | default: 'bottom'
  assign autoplay      = section.settings.autoplay
  assign autoplay_ms   = section.settings.autoplay_interval | default: 4 | times: 1000

  assign width_type = section.settings.section_width
  if width_type == blank
    assign width_class = 'default-width'
  else
    assign width_class = width_type
  endif

  assign show_recs = false
  if recommendations.performed and recommendations.products_count > 0
    assign show_recs = true
  endif

  assign show_side_arrows   = false
  assign show_top_arrows    = false
  assign show_bottom_arrows = false
  if show_arrows and arrow_position == 'side'
    assign show_side_arrows = true
  elsif show_arrows and arrow_position == 'top'
    assign show_top_arrows = true
  elsif show_arrows
    assign show_bottom_arrows = true
  endif
-%}

{{ 'product-recommendations.css' | asset_url | stylesheet_tag }}

<section
  class="pr-carousel cs-{{ cs }}{% if show_side_arrows %} pr-carousel--side-arrows{% endif %} {{ width_class }}"
  id="pr-section-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-recommendations-url="{{ routes.product_recommendations_url }}"
  data-product-id="{{ product.id }}"
  data-limit="{{ limit }}"
  data-performed="{{ show_recs }}"
  data-cols-desktop="{{ cols_desktop }}"
  data-cols-mobile="{{ cols_mobile }}"
  data-autoplay="{{ autoplay }}"
  data-autoplay-interval="{{ autoplay_ms }}"
  data-arrow-style="{{ arrow_position }}"
  style="
    --pr-cols-desktop: {{ cols_desktop }};
    --pr-cols-mobile: {{ cols_mobile }};
    --pr-gap: {{ gap }}px;
    --pr-pad-top: {{ pad_top }}px;
    --pr-pad-bottom: {{ pad_bottom }}px;
    --section-padding: {{ section.settings.section_padding }}px;
    {%- if width_type == 'custom-width' %}
      --custom-width: {{ section.settings.custom_width }}rem;
    {%- endif %}
  "
  aria-label="{{ heading | escape }}"
  {%- unless show_recs %} hidden{% endunless -%}
>

  {%- if heading != blank or subheading != blank or show_top_arrows -%}
    <div class="pr-carousel__header">
      <div class="pr-carousel__heading-group">
        {%- if heading != blank -%}<h2 class="pr-carousel__heading">{{ heading }}</h2>{%- endif -%}
        {%- if subheading != blank -%}<p class="pr-carousel__subheading">{{ subheading }}</p>{%- endif -%}
      </div>
      {%- if show_top_arrows -%}
        <div class="pr-carousel__arrows pr-carousel__arrows--top">
          <button class="pr-carousel__arrow" type="button" aria-label="Previous" data-pr-prev disabled>
            <svg width="16" height="16" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M11 14L6 9L11 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="pr-carousel__arrow" type="button" aria-label="Next" data-pr-next>
            <svg width="16" height="16" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M7 4L12 9L7 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="pr-carousel__stage">

    {%- if show_side_arrows -%}
      <button class="pr-carousel__arrow pr-carousel__arrow--side pr-carousel__arrow--side-prev" type="button" aria-label="Previous" data-pr-prev disabled>
        <svg width="16" height="16" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M11 14L6 9L11 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    {%- endif -%}

    <div class="pr-carousel__track-wrapper" data-pr-wrapper>
      <ul class="pr-carousel__track" id="pr-track-{{ section.id }}" data-pr-track role="list" aria-label="{{ heading | escape }}">
        {%- if show_recs -%}
          {%- for rec_product in recommendations.products limit: limit -%}
            <li class="pr-carousel__slide" data-pr-slide>
              {%- render 'product-card', product: rec_product -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..limit) -%}
            <li class="pr-carousel__slide" data-pr-slide>
              <div class="pr-placeholder-card">
                <div class="pr-placeholder-card__image">
                  {{ 'product-' | append: i | placeholder_svg_tag: 'pr-placeholder-card__svg' }}
                </div>
                <div class="pr-placeholder-card__body">
                  <div class="pr-placeholder-card__line pr-placeholder-card__line--title"></div>
                  <div class="pr-placeholder-card__line pr-placeholder-card__line--title pr-placeholder-card__line--title-short"></div>
                  <div class="pr-placeholder-card__line pr-placeholder-card__line--price"></div>
                </div>
              </div>
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>

    {%- if show_side_arrows -%}
      <button class="pr-carousel__arrow pr-carousel__arrow--side pr-carousel__arrow--side-next" type="button" aria-label="Next" data-pr-next>
        <svg width="16" height="16" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M7 4L12 9L7 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    {%- endif -%}

  </div>

  {%- if show_bottom_arrows -%}
    <div class="pr-carousel__nav">
      <div class="pr-carousel__dots" data-pr-dots></div>
      <div class="pr-carousel__arrows">
        <button class="pr-carousel__arrow" type="button" aria-label="Previous" data-pr-prev>
          <svg width="16" height="16" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M11 14L6 9L11 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="pr-carousel__arrow" type="button" aria-label="Next" data-pr-next>
          <svg width="16" height="16" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M7 4L12 9L7 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
  {%- endif -%}

</section>

<script src="{{ 'product-recommendations.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Related products",
  "tag": "section",
  "class": "section-product-recommendations",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Number of products",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Cards visible — desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Cards visible — mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap (px)",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 16
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Controls"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show prev / next arrows",
      "default": true
    },
    {
      "type": "select",
      "id": "arrow_position",
      "label": "Arrow style",
      "options": [
        { "value": "bottom", "label": "Below carousel" },
        { "value": "top",    "label": "Top right" },
        { "value": "side",   "label": "Either side" }
      ],
      "default": "bottom"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "Autoplay interval (seconds)",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "light",  "label": "Light" },
        { "value": "gray",   "label": "Light gray" },
        { "value": "dark",   "label": "Dark" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "light"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    }
  ],
  "templates": ["product"],
  "presets": [
    {
      "name": "Related products",
      "settings": {
        "heading": "You may also like",
        "products_to_show": 4
      }
    }
  ]
}
{% endschema %}
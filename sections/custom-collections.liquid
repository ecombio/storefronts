{%- comment -%}
  sections/custom-collections.liquid

  Forked from sections/collection-carousel.liquid. Collections shown
  here come solely from the page metafield
  page.metafields.custom.collections (type: List of Collections) —
  no section blocks, no metaobject. This section only renders a
  populated carousel on templates where `page` is in scope (the page
  template) — on any other template the metafield is blank and the
  carousel falls back to placeholder items.

  Uses its own assets (custom-collections.css/js) and a ccm- class
  prefix so it can be placed on the same page as
  sections/collection-carousel.liquid without collisions. Do not
  point this file at collection-carousel.css/js.
{%- endcomment -%}

{{ 'custom-collections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign width_type = section.settings.section_width
  if width_type == blank
    assign width_suffix = 'default-width'
  else
    assign width_suffix = width_type
  endif
  assign width_class = 'ccm-section__' | append: width_suffix

  assign collections = page.metafields.custom.collections.value
-%}

<div
  class="ccm-section"
  {% unless section.settings.enable_animations %}data-animations="off"{% endunless %}
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};"
>
  <div
    class="ccm-section__inner {{ width_class }}"
    style="
      --section-padding: {{ section.settings.section_padding }}px;
      {%- if width_type == 'custom-width' %}
        --custom-width: {{ section.settings.custom_width }}rem;
      {%- endif %}
    "
  >

    {%- if section.settings.heading != blank or section.settings.view_all_label != blank -%}
      <div class="ccm-section__header ccm-section__header--align-{{ section.settings.heading_align }}">
        <div class="ccm-section__header-text">
          {%- if section.settings.heading != blank -%}
            <h2 class="ccm-section__heading">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="ccm-section__subheading">{{ section.settings.subheading }}</p>
          {%- endif -%}
        </div>
        {%- if section.settings.view_all_label != blank and section.settings.view_all_link != blank -%}
          <a href="{{ section.settings.view_all_link }}" class="ccm-section__view-all">
            {{- section.settings.view_all_label -}}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" width="16" height="16">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="ccm-carousel" data-ccm-carousel style="--ccm-btn-bg: {{ section.settings.bg_color }};">
      <div class="ccm-carousel__track" data-ccm-carousel-track>
        {%- for collection in collections -%}
          {%- liquid
            assign shape = section.settings.image_shape
            assign label = collection.title
            assign image = collection.featured_image
          -%}

          <div class="ccm-carousel__item">
            <a href="{{ collection.url }}" class="ccm-carousel__link">
              <span class="ccm-carousel__image-wrap ccm-carousel__image-wrap--{{ shape }}">
                {%- if image != blank -%}
                  <img
                    class="ccm-carousel__image"
                    src="{{ image | image_url: width: 400 }}"
                    srcset="{{ image | image_url: width: 200 }} 200w, {{ image | image_url: width: 400 }} 400w, {{ image | image_url: width: 600 }} 600w"
                    sizes="(min-width: 990px) 160px, (min-width: 750px) 130px, 100px"
                    alt="{{ image.alt | default: label | escape }}"
                    loading="lazy"
                    width="{{ image.width }}"
                    height="{{ image.height }}"
                  >
                {%- else -%}
                  <span class="ccm-carousel__placeholder">
                    {{ 'collection-1' | placeholder_svg_tag: 'ccm-carousel__placeholder-svg' }}
                  </span>
                {%- endif -%}
              </span>
              <span class="ccm-carousel__label">{{ label }}</span>
            </a>
          </div>

        {%- else -%}
          {%- for i in (1..6) -%}
            <div class="ccm-carousel__item">
              <a href="#" class="ccm-carousel__link" tabindex="-1" aria-disabled="true">
                <span class="ccm-carousel__image-wrap ccm-carousel__image-wrap--{{ section.settings.image_shape }}">
                  <span class="ccm-carousel__placeholder">
                    {{ 'collection-1' | placeholder_svg_tag: 'ccm-carousel__placeholder-svg' }}
                  </span>
                </span>
                <span class="ccm-carousel__label">Collection</span>
              </a>
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>

      {%- if collections.size > 0 -%}
        <button type="button" class="ccm-carousel__btn ccm-carousel__btn--prev" data-ccm-carousel-prev aria-label="Previous">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button type="button" class="ccm-carousel__btn ccm-carousel__btn--next" data-ccm-carousel-next aria-label="Next">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      {%- endif -%}
    </div>

  </div>
</div>

<script src="{{ 'custom-collections.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Custom collections",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "options": [
        { "value": "start",  "label": "Left"   },
        { "value": "center", "label": "Center" },
        { "value": "end",    "label": "Right"  }
      ],
      "default": "start"
    },
    {
      "type": "paragraph",
      "content": "Collections are pulled from the page metafield custom.collections (List of Collections). Set that metafield on this page to control which collections appear."
    },
    {
      "type": "header",
      "content": "View all link"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Link label",
      "default": "View all",
      "info": "Leave blank to hide"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Image shape",
      "options": [
        { "value": "circle",    "label": "Circle"             },
        { "value": "rounded",   "label": "Rounded square"     },
        { "value": "square",    "label": "Square"             },
        { "value": "landscape", "label": "Landscape (uncropped)" }
      ],
      "default": "circle"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "checkbox",
      "id": "enable_animations",
      "label": "Enable hover animations",
      "info": "Card lift, image zoom, and label underline on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Custom collections"
    }
  ]
}
{% endschema %}

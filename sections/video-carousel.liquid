{% schema %}
{
  "name": "Video carousel",
  "tag": "section",
  "class": "section video-carousel",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Watch & learn" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "color", "id": "background_color", "label": "Background color" },
    { "type": "color", "id": "text_color", "label": "Text color" },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        { "value": "standard", "label": "Standard (16:9)" },
        { "value": "reel", "label": "Reel / Shorts (9:16)" }
      ],
      "default": "standard"
    },
    { "type": "range", "id": "slides_desktop", "label": "Videos per view (desktop)", "min": 1, "max": 5, "step": 1, "default": 3 },
    { "type": "range", "id": "slides_tablet", "label": "Videos per view (tablet)", "min": 1, "max": 4, "step": 1, "default": 2 },
    { "type": "range", "id": "slides_mobile", "label": "Videos per view (mobile)", "min": 1, "max": 4, "step": 1, "default": 1 },
    { "type": "range", "id": "gap", "label": "Gap between videos", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 16 },
    { "type": "checkbox", "id": "show_arrows", "label": "Show navigation arrows", "default": true },
    { "type": "checkbox", "id": "show_dots", "label": "Show dots", "default": true },
    {
      "type": "checkbox",
      "id": "autoplay_first",
      "label": "Autoplay first video's sound off preview",
      "default": false,
      "info": "Only applies to uploaded MP4 videos, muted."
    },
    { "type": "header", "content": "Section layout" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": "",
      "info": "Default caps the carousel at your theme's standard content width. Full width spans edge-to-edge. Custom width lets you set an exact max width below."
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24,
      "info": "This section's own side padding, independent of the global Body side padding setting."
    },
    { "type": "header", "content": "Shoppable videos" },
    {
      "type": "select",
      "id": "cta_style",
      "label": "Product CTA style",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "overlay", "label": "Overlay" },
        { "value": "icon_button", "label": "Icon button" },
        { "value": "text_button", "label": "Text button" },
        { "value": "card_outside_video", "label": "Card outside video" }
      ],
      "default": "card_outside_video",
      "info": "Applies to every video block in this carousel that has a product selected. Choose None to hide the on-card CTA (the video still opens the product modal on click)."
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "video_url",
          "id": "video_url",
          "label": "Video URL",
          "accept": ["youtube", "vimeo"],
          "info": "Paste a YouTube or Vimeo link. Leave blank if uploading a file below."
        },
        { "type": "video", "id": "video_file", "label": "Or upload a video file" },
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Thumbnail image",
          "info": "Recommended if using a Video URL. Uploaded videos can use their own preview image."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Optional. If selected, the video opens in a split view with this product's card alongside the video."
        },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" }
      ]
    }
  ],
  "presets": [
    { "name": "Video carousel", "blocks": [{ "type": "video" }, { "type": "video" }, { "type": "video" }] }
  ]
}
{% endschema %}
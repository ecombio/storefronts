{%- comment -%}
  product-card.liquid doesn't load its own CSS (see asset ownership rule
  in that file) — it expects the host page to have loaded it already.
  Since a shoppable video block can render a product-card inside the
  modal on any page this section is placed on, load it here explicitly.
{%- endcomment -%}
{{ 'product-card.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Section width / side padding below follow the pattern from
  sections/example-width-section.liquid: --section-padding and
  --custom-width are local to THIS section instance and are only ever
  set inline here. They never read from the global --page-margin /
  --page-width variables (snippets/css-variables.liquid), so bumping
  the global Body side padding setting can no longer break this
  section's layout the way it broke the old full_width checkbox.

  Unlike the example section, this theme has no shared global
  default-width/full-width/custom-width utility classes, so these
  are scoped to this component as video-carousel__default-width /
  video-carousel__full-width / video-carousel__custom-width in
  video-carousel.css, replacing the old .video-carousel__boxed and
  .video-carousel__full-bleed rules.
{%- endcomment -%}

{%- liquid
  assign show_arrows = section.settings.show_arrows
  assign show_dots = section.settings.show_dots
  assign width_type = section.settings.section_width
  if width_type == blank
    assign width_class = 'video-carousel__default-width'
  else
    assign width_class = 'video-carousel__' | append: width_type
  endif
-%}

<div
  class="video-carousel-section"
  id="VideoCarousel-{{ section.id }}"
  data-video-carousel
  data-section-id="{{ section.id }}"
  data-autoplay-first="{{ section.settings.autoplay_first }}"
  style="
    --vc-slides-desktop: {{ section.settings.slides_desktop }};
    --vc-slides-tablet: {{ section.settings.slides_tablet }};
    --vc-slides-mobile: {{ section.settings.slides_mobile }};
    --vc-gap: {{ section.settings.gap }}px;
    {% if section.settings.background_color != blank %}--vc-bg: {{ section.settings.background_color }};{% endif %}
    {% if section.settings.text_color != blank %}--vc-text: {{ section.settings.text_color }};{% endif %}
    --vc-card-ratio: {% if section.settings.card_style == 'reel' %}9 / 16{% else %}16 / 9{% endif %};
  "
>
  <div
    class="{{ width_class }}"
    style="
      --section-padding: {{ section.settings.section_padding }}px;
      {%- if width_type == 'custom-width' %}
        --custom-width: {{ section.settings.custom_width }}rem;
      {%- endif %}
    "
  >
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="video-carousel__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="video-carousel__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="video-carousel__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="video-carousel__wrapper">
      {%- if show_arrows -%}
        <button
          type="button"
          class="video-carousel__arrow video-carousel__arrow--prev"
          aria-label="Previous videos"
          data-carousel-prev
        >
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path d="M15 4l-8 8 8 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      {%- endif -%}

      <div
        class="video-carousel__track"
        data-carousel-track
        tabindex="0"
        role="region"
        aria-label="{{ section.settings.heading | default: 'Video carousel' }}"
      >
        <div class="video-carousel__list" data-carousel-list>
          {%- for block in section.blocks -%}
            {%- if block.type == 'video' -%}
              {%- render 'video-card', block: block, index: forloop.index, cta_style: section.settings.cta_style -%}
            {%- endif -%}
          {%- else -%}
            <p class="video-carousel__empty">Add video blocks in the theme editor.</p>
          {%- endfor -%}
        </div>
      </div>

      {%- if show_arrows -%}
        <button
          type="button"
          class="video-carousel__arrow video-carousel__arrow--next"
          aria-label="Next videos"
          data-carousel-next
        >
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path d="M9 4l8 8-8 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      {%- endif -%}
    </div>

    {%- if show_dots -%}
      <div class="video-carousel__dots" data-carousel-dots role="tablist" aria-label="Slide navigation"></div>
    {%- endif -%}
  </div>
</div>

{%- render 'video-modal' -%}


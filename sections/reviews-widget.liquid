{%- comment -%}==================================================
  SECTION LAYOUT (width + padding)
  Same local width-class pattern as sections/main-product.liquid --
  kept local rather than reading global --page-margin / --page-width
  vars for the same reasons documented there.
==================================================
{%- endcomment -%}
{%- liquid
  assign width_type = section.settings.section_width
  if width_type == blank
    assign width_class = 'reviews-widget__default-width'
  elsif width_type == 'full-width'
    assign width_class = 'reviews-widget__full-width'
  else
    assign width_class = 'reviews-widget__custom-width'
  endif
-%}

<div
  class="reviews-widget-section {{ width_class }}"
  id="reviews"
  style="
    --section-padding: {{ section.settings.section_padding }}px;
    {%- if width_type == 'custom-width' %}
      --custom-width: {{ section.settings.custom_width }}rem;
    {%- endif %}
  "
>
  {%- if section.settings.heading != blank -%}
    <h2 class="reviews-widget-heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- comment -%}
    All the actual data-yotpo-* markup lives in snippets/yotpo-widgets.liquid
    (widget_type: 'yotpo_review_widget') -- this section only owns layout/
    heading/schema, so the widget attributes stay correct in one place.
  {%- endcomment -%}
  {%- render 'yotpo-widgets', widget_type: 'yotpo_review_widget', product: product -%}
</div>

{% schema %}
{
  "name": "Reviews widget",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer Reviews"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Reviews widget"
    }
  ]
}
{% endschema %}
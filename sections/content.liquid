{{ 'content.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }} {
    --content-media-width: {{ section.settings.media_width }}%;
    --content-gap: {{ section.settings.column_gap }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- if section.settings.background_color != blank -%}
      --content-bg: {{ section.settings.background_color }};
    {%- endif -%}
    {%- if section.settings.text_color != blank -%}
      --content-text: {{ section.settings.text_color }};
    {%- endif -%}
  }
  @media screen and (max-width: 749px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{%- endstyle -%}

<div
  class="content-section section-{{ section.id }} color-{{ section.settings.color_scheme }}{% if section.settings.reverse_layout %} content-section--reverse{% endif %}{% unless section.settings.mobile_media_first %} content-section--mobile-content-first{% endunless %}"
  data-section-id="{{ section.id }}"
  data-section-type="content"
>
  {%- liquid
    assign width_type = section.settings.section_width
    if width_type == blank
      assign width_class = 'content-section__default-width'
    elsif width_type == 'full-width'
      assign width_class = 'content-section__full-width'
    else
      assign width_class = 'content-section__custom-width'
    endif
  -%}
  <div
    class="content-section__inner {{ width_class }} content-section__inner--align-{{ section.settings.vertical_alignment }}"
    style="
      --section-padding: {{ section.settings.section_padding }}px;
      {%- if width_type == 'custom-width' %}
        --custom-width: {{ section.settings.custom_width }}rem;
      {%- endif %}
    "
  >

    <div class="content-section__media">
      {%- liquid
        assign has_video = false
        if section.settings.media_type == 'video' and section.settings.video != blank
          assign has_video = true
        endif
      -%}

      {%- if has_video -%}
        <div class="content-section__media-wrap content-section__media-wrap--video" data-video-wrap>
          {%- if section.settings.video.host == 'shopify' -%}
            {{
              section.settings.video
              | video_tag:
                image_size: '1100x',
                autoplay: section.settings.autoplay,
                loop: section.settings.loop,
                muted: section.settings.autoplay,
                controls: section.settings.show_controls,
                class: 'content-section__video',
                preload: 'metadata'
            }}
          {%- else -%}
            {{ section.settings.video | external_video_tag: class: 'content-section__video' }}
          {%- endif -%}
        </div>
      {%- elsif section.settings.image -%}
        <div class="content-section__media-wrap">
          {{
            section.settings.image
            | image_url: width: 1500
            | image_tag:
              loading: 'lazy',
              widths: '375, 550, 750, 1100, 1500',
              sizes: '(min-width: 750px) 50vw, 100vw',
              class: 'content-section__image',
              alt: section.settings.image.alt | default: section.settings.heading
          }}
        </div>
      {%- else -%}
        <div class="content-section__media-wrap content-section__media-wrap--placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'content-section__placeholder' }}
        </div>
      {%- endif -%}
    </div>

    <div class="content-section__content">
      <div class="content-section__content-inner">
        <span class="content-section__eyebrow" aria-hidden="true"></span>

        {%- if section.settings.subheading != blank -%}
          <p class="content-section__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="content-section__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="content-section__text rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="content-section__buttons">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'button' -%}
                  {%- if block.settings.button_label != blank -%}
                    <a
                      {% if block.settings.button_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.button_link }}"{% endif %}
                      class="button button--{{ block.settings.button_style }}"
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.button_label | escape }}
                    </a>
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>

  </div>
</div>

<script src="{{ 'content.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Content",
  "tag": "section",
  "class": "shopify-section--content",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "reverse_layout",
      "label": "Swap column order (media on right)",
      "default": false
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "options": [
        { "value": "start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "Media column width",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "checkbox",
      "id": "mobile_media_first",
      "label": "Show media first on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Upload a file, or paste a YouTube/Vimeo URL."
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay (muted, loops silently)",
      "default": false,
      "info": "Only applies to uploaded video files."
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop video",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Show video controls",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for every ride"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Tell your story here. Describe the product, the mission, or what makes this moment worth stopping for.</p>"
    },
    {
      "type": "header",
      "content": "Section styling"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Leave blank to inherit the color scheme's background."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "Leave blank to inherit the color scheme's text color."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "Label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Style",
          "options": [
            { "value": "primary", "label": "Primary" },
            { "value": "secondary", "label": "Secondary" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Content",
      "blocks": [
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
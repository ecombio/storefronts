{# sections/header-section.liquid #}

{{ 'header-section.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign logo       = settings.logo
  assign logo_width = settings.logo_width | default: 110
  assign show_acct  = section.settings.show_icon_account
  assign show_cart  = section.settings.show_icon_cart
  assign show_wish  = section.settings.show_icon_wishlist
  assign show_comp  = section.settings.show_icon_compare
  assign label_acct = section.settings.show_label_account
  assign label_cart = section.settings.show_label_cart
  assign label_wish = section.settings.show_label_wishlist
  assign label_comp = section.settings.show_label_compare

  assign section_width = section.settings.section_width
  case section_width
    when 'full-width'
      assign width_class = 'main-header--full-width'
    when 'custom-width'
      assign width_class = 'main-header--custom-width'
    else
      assign width_class = 'main-header--default-width'
  endcase

  assign hs_predictive = section.settings.enable_predictive_search
  if hs_predictive == blank
    assign hs_predictive = true
  endif

  assign search_panel_width = section.settings.search_panel_width
  case search_panel_width
    when 'full-width'
      assign search_panel_width_class = 'header-search__panel--full-width'
    when 'custom-width'
      assign search_panel_width_class = 'header-search__panel--custom-width'
    else
      assign search_panel_width_class = 'header-search__panel--default-width'
  endcase
-%}

<script>
  window.HS_TRENDING = window.HS_TRENDING || [
    "electric scooters","electric bikes","electric skateboards","electric cargo bikes",
    "electric city bikes","electric fat bikes","electric folding bikes","electric mountain bikes",
    "commuter electric scooters","off-road electric scooters","performance electric scooters","youth electric scooters"
  ];
</script>

<header
  class="main-header {{ width_class }}"
  id="main-header"
  role="banner"
  style="
    --section-padding: {{ section.settings.section_padding }}px;
    {%- if section_width == 'custom-width' %}
      --custom-width: {{ section.settings.custom_width }}rem;
    {%- endif %}
    --search-panel-custom-width: {{ section.settings.search_panel_custom_width }}rem;
    --search-panel-padding: {{ section.settings.search_panel_padding }}px;
  "
>
  <div class="main-header__bar">
    <div class="main-header__inner">

      {%- if section.blocks.size > 0 -%}
        <button type="button"
                class="ecombio-header__hamburger"
                id="main-header-menu-trigger"
                aria-expanded="false"
                aria-controls="main-header-mobile-nav"
                aria-label="Open menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      {%- endif -%}

      <div class="main-header__logo">
        <a href="{{ routes.root_url }}"
           class="main-header__logo-link"
           style="--logo-width: {{ logo_width }}px"
           aria-label="{{ shop.name }} — home">
          {%- if logo != blank -%}
            {%- assign logo_2x = logo_width | times: 2 -%}
            <img class="main-header__logo-img"
                 src="{{ logo | image_url: width: logo_width }}"
                 srcset="{{ logo | image_url: width: logo_width }} 1x,
                         {{ logo | image_url: width: logo_2x }} 2x"
                 alt="{{ logo.alt | default: shop.name | escape }}"
                 width="{{ logo_width }}"
                 height="{{ logo_width | divided_by: logo.aspect_ratio | round }}"
                 loading="eager"
                 fetchpriority="high">
          {%- else -%}
            <span class="main-header__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>
      </div>

      <div class="main-header__nav-group">
        <div class="main-header__search-bar-inline">
          {%- liquid
            assign hs_sfx = 'desktop-bar'
          -%}
          <div class="header-search header-search--{{ hs_sfx }}{% unless hs_predictive %} header-search--basic{% endunless %}"
               data-search-root
               data-search-variant="{{ hs_sfx }}"
               {%- if hs_predictive %}
               data-predictive
               data-predictive-search-url="{{ routes.predictive_search_url }}"
               data-search-url="{{ routes.search_url }}"
               {%- endif %}
               data-typewriter-enabled>

            <form action="{{ routes.search_url }}" method="get" role="search"
                  class="header-search__form"
                  id="HeaderSearchForm-{{ hs_sfx }}"
                  autocomplete="off">

              <input type="hidden" name="type" value="product">
              <label class="visually-hidden" for="HeaderSearch-{{ hs_sfx }}">Search</label>

              <input type="search" name="q"
                     id="HeaderSearch-{{ hs_sfx }}"
                     class="header-search__input"
                     data-search-input
                     placeholder="Search for..."
                     value="{{ search.terms | escape }}"
                     autocorrect="off" autocapitalize="off" spellcheck="false"
                     {%- if hs_predictive %}
                     role="combobox"
                     aria-expanded="false"
                     aria-owns="HeaderSearchResults-{{ hs_sfx }}"
                     aria-controls="HeaderSearchResults-{{ hs_sfx }}"
                     aria-haspopup="listbox"
                     aria-autocomplete="list"
                     {%- endif %}>

              <span class="header-search__typewriter" data-search-typewriter aria-hidden="true"><span class="header-search__typewriter-prefix">Search for </span><span class="header-search__typewriter-term" data-search-typewriter-term></span></span>

              <button type="button" class="header-search__clear" data-search-clear hidden aria-label="Clear search">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                  <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
              </button>

              <button type="button" class="header-search__voice" data-search-voice hidden aria-label="Search by voice">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                  <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                  <line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/>
                </svg>
              </button>

              <button type="submit" class="header-search__submit" aria-label="Search">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
              </button>

            </form>

            {%- if hs_predictive -%}
              <div class="header-search__panel {{ search_panel_width_class }}"
                   id="HeaderSearchResults-{{ hs_sfx }}"
                   data-search-results
                   role="listbox"
                   aria-label="Search suggestions"
                   tabindex="-1"></div>
              <span class="visually-hidden" role="status" aria-live="polite" data-search-status></span>
            {%- endif -%}

          </div>
        </div>
      </div>

      <ul class="main-header__icons" role="list" aria-label="Header actions">
        {%- if show_wish != false -%}
          <li class="main-header__icons-item--wishlist">{%- render 'header-wishlist', show_label: label_wish -%}</li>
        {%- endif -%}
        {%- if show_comp != false -%}
          <li>{%- render 'header-compare', show_label: label_comp -%}</li>
        {%- endif -%}
        {%- if show_acct != false -%}
          <li>{%- render 'header-account', show_label: label_acct -%}</li>
        {%- endif -%}
        {%- if show_cart != false -%}
          <li>{%- render 'header-cart', show_label: label_cart -%}</li>
        {%- endif -%}
      </ul>

    </div>
  </div>

  <div class="main-header__menu-row">
    {%- render 'header-menu', blocks: section.blocks -%}
  </div>

  <div class="main-header__search-row">
    <div class="main-header__search-row-inner">
      {%- liquid
        assign hs_sfx = 'mobile'
      -%}
      <div class="header-search header-search--{{ hs_sfx }}{% unless hs_predictive %} header-search--basic{% endunless %}"
           data-search-root
           data-search-variant="{{ hs_sfx }}"
           {%- if hs_predictive %}
           data-predictive
           data-predictive-search-url="{{ routes.predictive_search_url }}"
           data-search-url="{{ routes.search_url }}"
           {%- endif %}
           data-typewriter-enabled>

        <form action="{{ routes.search_url }}" method="get" role="search"
              class="header-search__form"
              id="HeaderSearchForm-{{ hs_sfx }}"
              autocomplete="off">

          <input type="hidden" name="type" value="product">
          <label class="visually-hidden" for="HeaderSearch-{{ hs_sfx }}">Search</label>

          <input type="search" name="q"
                 id="HeaderSearch-{{ hs_sfx }}"
                 class="header-search__input"
                 data-search-input
                 placeholder="Search for..."
                 value="{{ search.terms | escape }}"
                 autocorrect="off" autocapitalize="off" spellcheck="false"
                 {%- if hs_predictive %}
                 role="combobox"
                 aria-expanded="false"
                 aria-owns="HeaderSearchResults-{{ hs_sfx }}"
                 aria-controls="HeaderSearchResults-{{ hs_sfx }}"
                 aria-haspopup="listbox"
                 aria-autocomplete="list"
                 {%- endif %}>

          <span class="header-search__typewriter" data-search-typewriter aria-hidden="true"><span class="header-search__typewriter-prefix">Search for </span><span class="header-search__typewriter-term" data-search-typewriter-term></span></span>

          <button type="button" class="header-search__clear" data-search-clear hidden aria-label="Clear search">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>

          <button type="button" class="header-search__voice" data-search-voice hidden aria-label="Search by voice">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
              <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
              <line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/>
            </svg>
          </button>

          <button type="submit" class="header-search__submit" aria-label="Search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
          </button>

        </form>

        {%- if hs_predictive -%}
          <div class="header-search__panel {{ search_panel_width_class }}"
               id="HeaderSearchResults-{{ hs_sfx }}"
               data-search-results
               role="listbox"
               aria-label="Search suggestions"
               tabindex="-1"></div>
          <span class="visually-hidden" role="status" aria-live="polite" data-search-status></span>
        {%- endif -%}

      </div>
    </div>
  </div>

</header>

<script src="{{ 'header-section.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Header Section",
  "tag": "div",
  "class": "main-header-section",
  "settings": [
    { "type": "header", "content": "Section layout" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40, "max": 120, "step": 5, "unit": "rem", "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0, "max": 80, "step": 4, "unit": "px", "default": 32
    },

    { "type": "header", "content": "Search (all breakpoints)" },
    { "type": "checkbox", "id": "enable_predictive_search", "label": "Enable predictive search", "default": true },

    { "type": "header", "content": "Panel layout" },
    {
      "type": "select",
      "id": "search_panel_width",
      "label": "Panel width",
      "options": [
        { "value": "", "label": "Default (aligns with header)" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "search_panel_custom_width",
      "label": "Custom width",
      "min": 40, "max": 120, "step": 5, "unit": "rem", "default": 80,
      "visible_if": "{{ section.settings.search_panel_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "search_panel_padding",
      "label": "Side padding",
      "min": 0, "max": 80, "step": 4, "unit": "px", "default": 16
    },

    { "type": "header", "content": "Icons (all breakpoints)" },
    { "type": "checkbox", "id": "show_icon_account", "label": "Show account icon", "default": false },
    { "type": "checkbox", "id": "show_label_account", "label": "Show account label", "default": false },
    { "type": "checkbox", "id": "show_icon_wishlist", "label": "Show wishlist icon", "default": true },
    { "type": "checkbox", "id": "show_label_wishlist", "label": "Show wishlist label", "default": false },
    { "type": "checkbox", "id": "show_icon_compare", "label": "Show compare icon", "default": false },
    { "type": "checkbox", "id": "show_label_compare", "label": "Show compare label", "default": false },
    { "type": "checkbox", "id": "show_icon_cart", "label": "Show cart icon", "default": true },
    { "type": "checkbox", "id": "show_label_cart", "label": "Show cart label", "default": false }
  ],
  "blocks": [
    { "type": "single-link", "name": "Single Link", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Single Link" },
      { "type": "url", "id": "link", "label": "URL" },
      { "type": "text", "id": "icon", "label": "Icon name" }
    ]},
    { "type": "link-list", "name": "Link list", "settings": [
      { "type": "text", "id": "label", "label": "Label" },
      { "type": "url", "id": "link", "label": "Top-level URL (optional)" },
      { "type": "link_list", "id": "menu", "label": "Link list menu" },
      { "type": "text", "id": "icon", "label": "Icon name" }
    ]},
    { "type": "mega-menu", "name": "Mega menu", "settings": [
      { "type": "header", "content": "Nav bar" },
      { "type": "text", "id": "label", "label": "Label" },
      { "type": "url", "id": "link", "label": "URL" },
      { "type": "link_list", "id": "menu", "label": "Menu" },
      { "type": "text", "id": "icon", "label": "Icon name" },
      { "type": "header", "content": "Products" },
      { "type": "checkbox", "id": "show_products", "label": "Show trending products", "default": false }
    ]},
    { "type": "showcase", "name": "Showcase", "settings": [
      { "type": "header", "content": "Nav bar" },
      { "type": "text", "id": "label", "label": "Label" },
      { "type": "url", "id": "link", "label": "URL" },
      { "type": "text", "id": "icon", "label": "Icon name" },
      { "type": "header", "content": "Panel layout" },
      { "type": "select", "id": "panel_width", "label": "Panel width", "options": [
        { "value": "", "label": "Default (aligns with header)" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ], "default": "" },
      { "type": "range", "id": "panel_custom_width", "label": "Custom width", "min": 40, "max": 120, "step": 5, "unit": "rem", "default": 80, "visible_if": "{{ block.settings.panel_width == 'custom-width' }}" },
      { "type": "range", "id": "panel_padding", "label": "Side padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 24 },
      { "type": "header", "content": "\"See all\" link" },
      {
        "type": "text",
        "id": "see_all_label",
        "label": "Link text",
        "default": "View all",
        "info": "Shown at the top-right of the Categories panel, next to the \"Categories\" heading."
      },
      {
        "type": "url",
        "id": "see_all_link",
        "label": "Link URL",
        "info": "If left blank, this falls back to the collection the Nav bar URL above points to (if any)."
      },
      { "type": "header", "content": "Sidebar (optional)" },
      { "type": "checkbox", "id": "show_sidebar", "label": "Show sidebar", "default": true },
      { "type": "text", "id": "sidebar_heading", "label": "Sidebar heading", "default": "Good to know" },
      { "type": "text", "id": "tip_1_icon", "label": "Tip 1 icon name" },
      { "type": "text", "id": "tip_1_heading", "label": "Tip 1 heading", "default": "Trade-in" },
      { "type": "text", "id": "tip_1_body", "label": "Tip 1 body", "default": "Get up to $700 for your old device" },
      { "type": "text", "id": "tip_2_icon", "label": "Tip 2 icon name" },
      { "type": "text", "id": "tip_2_heading", "label": "Tip 2 heading" },
      { "type": "text", "id": "tip_2_body", "label": "Tip 2 body" },
      { "type": "text", "id": "tip_3_icon", "label": "Tip 3 icon name" },
      { "type": "text", "id": "tip_3_heading", "label": "Tip 3 heading" },
      { "type": "text", "id": "tip_3_body", "label": "Tip 3 body" },
      { "type": "header", "content": "Categories" },
      { "type": "collection", "id": "cat_1_collection", "label": "Category 1 collection" },
      { "type": "collection", "id": "cat_2_collection", "label": "Category 2 collection" },
      { "type": "collection", "id": "cat_3_collection", "label": "Category 3 collection" },
      { "type": "collection", "id": "cat_4_collection", "label": "Category 4 collection" },
      { "type": "collection", "id": "cat_5_collection", "label": "Category 5 collection" },
      { "type": "collection", "id": "cat_6_collection", "label": "Category 6 collection" },
      { "type": "collection", "id": "cat_7_collection", "label": "Category 7 collection" },
      { "type": "collection", "id": "cat_8_collection", "label": "Category 8 collection" }
    ]},
    { "type": "highlight", "name": "Highlight", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "On Sale" },
      { "type": "url", "id": "link", "label": "URL" },
      { "type": "text", "id": "icon", "label": "Icon name" }
    ]},
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Header Section",
      "blocks": [
        { "type": "single-link", "settings": { "label": "Single link", "link": "/collections/all" } },
        { "type": "link-list", "settings": { "label": "Link list" } },
        { "type": "mega-menu", "settings": {} },
        { "type": "showcase", "settings": {} },
        { "type": "highlight", "settings": { "label": "On Sale", "link": "/collections/sale" } }
      ]
    }
  ]
}
{% endschema %}
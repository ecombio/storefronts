# ─────────────────────────────────────────────
# Shopify Storefront API (Public)
# Used by Hydrogen client-side components
# ─────────────────────────────────────────────
PUBLIC_STOREFRONT_ID=
PUBLIC_STOREFRONT_API_TOKEN=
PUBLIC_STORE_DOMAIN=

# ─────────────────────────────────────────────
# Shopify Storefront API (Private)
# Server-side only — DO NOT expose in client code
# ─────────────────────────────────────────────
PRIVATE_STOREFRONT_API_TOKEN=

# ─────────────────────────────────────────────
# Shopify Customer Accounts (Public)
# Used for login, registration, and session flows
# ─────────────────────────────────────────────
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
PUBLIC_CUSTOMER_ACCOUNT_API_URL=

# ─────────────────────────────────────────────
# Shopify Store Metadata
# ─────────────────────────────────────────────
SHOP_ID=

# ─────────────────────────────────────────────
# Hydrogen Session Secret
# Required for server-side session encryption
# ─────────────────────────────────────────────
SESSION_SECRET=

# ─────────────────────────────────────────────
# Algolia Search (Public)
# Safe to expose in client-side search components
# ─────────────────────────────────────────────
PUBLIC_ALGOLIA_APP_ID=
PUBLIC_ALGOLIA_SEARCH_KEY=
PUBLIC_ALGOLIA_INDEX_NAME=

# ─────────────────────────────────────────────
# Yotpo Reviews / UGC
# Store ID only — no secret keys
# ─────────────────────────────────────────────
YOTPO_STORE_ID=

# ─────────────────────────────────────────────
# Cloudflare R2 (Optional)
# Server-side only — DO NOT expose in client code
# ─────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=

# ─────────────────────────────────────────────
# Algolia Admin (Server-side only)
# Used for indexing and admin operations
# ─────────────────────────────────────────────
ALGOLIA_ADMIN_KEY=

# ─────────────────────────────────────────────
# Hydrogen Analytics (Optional)
# Public analytics identifier
# ─────────────────────────────────────────────
PUBLIC_HYDROGEN_ANALYTICS_ID=

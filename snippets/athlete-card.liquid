{%- comment -%}
  snippets/athlete-card.liquid

  Renders one card: a cover image with a circular avatar overlapping
  its bottom edge, and a content block (title + date) below it.

  Accepts:
    article       - required. An Article object (or anything with
                    .url, .title, .image, .published_at).
    avatar        - optional image object shown in the circular
                    badge. Omit to render the card with no avatar
                    badge at all (falls back to nothing, NOT to
                    article.image — a card's own cover photo is not
                    a sensible default avatar).
    avatar_alt    - optional string. Alt text for the avatar. Falls
                    back to `article.title`.
    loading       - optional boolean. true = eager-load the cover
                    image (use for above-the-fold cards). Default:
                    false (lazy).
    show_meta     - optional boolean. Show the published-date row.
                    Default: true.
{%- endcomment -%}

{%- liquid
  assign show_meta = show_meta | default: true
  assign avatar_alt = avatar_alt | default: article.title
-%}

<a href="{{ article.url }}" class="athlete-card" data-athlete-card>
  <div class="athlete-card__media">
    {%- if article.image -%}
      <img
        src="{{ article.image | image_url: width: 600 }}"
        srcset="{{ article.image | image_url: width: 400 }} 400w, {{ article.image | image_url: width: 600 }} 600w, {{ article.image | image_url: width: 800 }} 800w"
        sizes="(max-width: 640px) 90vw, 320px"
        alt="{{ article.image.alt | default: article.title | escape }}"
        class="athlete-card__image"
        width="{{ article.image.width }}"
        height="{{ article.image.height }}"
        loading="{% if loading %}eager{% else %}lazy{% endif %}"
      >
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'athlete-card__image athlete-card__image--placeholder' }}
    {%- endif -%}

    {%- if avatar -%}
      <span class="athlete-card__avatar-wrapper">
        <img
          src="{{ avatar | image_url: width: 160 }}"
          srcset="{{ avatar | image_url: width: 80 }} 80w, {{ avatar | image_url: width: 160 }} 160w"
          sizes="80px"
          alt="{{ avatar_alt | escape }}"
          class="athlete-card__avatar"
          width="80"
          height="80"
          loading="lazy"
        >
      </span>
    {%- endif -%}
  </div>

  <div class="athlete-card__content">
    <h3 class="athlete-card__title">{{ article.title }}</h3>

    {%- if show_meta and article.published_at -%}
      <span class="athlete-card__meta">{{ article.published_at | date: '%B %d, %Y' }}</span>
    {%- endif -%}
  </div>
</a>

{{ 'header-compare.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign show_icon_setting = show_icon
  if show_icon_setting == nil
    assign show_icon_setting = true
  endif

  assign show_label_setting = show_label
  if show_label_setting == nil
    assign show_label_setting = true
  endif
-%}

<a
  href="{{ pages.compare.url | default: '/pages/compare' }}"
  class="header-compare"
  data-header-compare
  aria-label="Compare products"
>
  {%- if show_icon_setting -%}
    <span class="header-compare__icon-wrap">
      <svg class="header-compare__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="m16 3 4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M20 7H4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="m8 21-4-4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M4 17h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="header-compare__badge" data-header-compare-badge hidden aria-hidden="true">0</span>
    </span>
  {%- endif -%}

  {%- if show_label_setting -%}
    <span class="header-compare__label">Compare</span>
  {%- endif -%}

  <span class="visually-hidden" data-header-compare-sr>Compare, no products selected</span>
</a>

<script src="{{ 'header-compare.js' | asset_url }}" defer></script>
# ─────────────────────────────────────────────
# Environment Files (Never Commit Secrets)
# ─────────────────────────────────────────────
.env
.env.*
!.env.example
.env.generated
.env.backup
.env.local.backup

# ─────────────────────────────────────────────
# Node / Hydrogen / Remix
# ─────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
.pnpm-store/

# Hydrogen build output
build/
dist/
public/build/
public/dist/

# Remix cache
.cache/
.remix/

# React Router (Hydrogen internal)
.react-router/

# Module Federation (Hydrogen internal)
.mf/

# ─────────────────────────────────────────────
# Shopify CLI / Oxygen CLI
# ─────────────────────────────────────────────
.shopify/
.oxygen/
oxygen.lock

# ─────────────────────────────────────────────
# Cloudflare Wrangler
# ─────────────────────────────────────────────
.wrangler/
.wrangler-state/
.wrangler/tmp/
.wrangler/kv/
.wrangler/d1/

# R2 local dev artifacts
r2/
r2-local/
r2-temp/

# ─────────────────────────────────────────────
# Logs
# ─────────────────────────────────────────────
logs/
*.log
*.log.*
debug.log

# ─────────────────────────────────────────────
# OS / Editor Junk
# ─────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ─────────────────────────────────────────────
# GitHub / CI
# ─────────────────────────────────────────────
.github/workflows/tmp/
.github/tmp/

# ─────────────────────────────────────────────
# Temporary / Generated Files
# ─────────────────────────────────────────────
tmp/
temp/
*.tmp
*.cache
*.pid
*.seed
*.tgz.env
